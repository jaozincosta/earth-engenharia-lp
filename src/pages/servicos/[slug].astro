---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { Check, X, Phone, ArrowRight, Scale } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import BrandIcon from '@/components/BrandIcon.astro';
import Faq from '@/components/Faq.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import { categories, serviceWhatsappMessage, site, whatsappUrl } from '@/config/site';
import { getRelated, getServices, serviceUrl, type Service } from '@/lib/services';
import { course, faqPage, service as serviceSchema } from '@/lib/schema';

export const getStaticPaths = (async () => {
  const services = await getServices();
  return services.map((service) => ({ params: { slug: service.id }, props: { service } }));
}) satisfies GetStaticPaths;

interface Props {
  service: Service;
}

const { service } = Astro.props;
const { data } = service;
const { Content } = await render(service);
const related = await getRelated(service);
const base = Astro.site!;
const url = new URL(serviceUrl(service), base).href;
const mainCategory = categories[data.categories[0]];
const message = serviceWhatsappMessage(data.title);
const crumbs = [
  { label: 'Serviços', href: '/servicos/' },
  { label: data.title, href: serviceUrl(service) },
];

const schema = [
  serviceSchema({ name: data.title, description: data.seoDescription, url, category: mainCategory.label }, base),
  faqPage(data.faq),
  ...(data.courses ?? []).map((c) => course(c, base)),
];
---

<BaseLayout title={data.seoTitle} description={data.seoDescription} schema={schema} breadcrumbs={crumbs} whatsappMessage={message}>
  <PageHero label={data.categories.map((c) => categories[c].label).join(' · ')} title={data.h1} lead={data.summary} crumbs={crumbs}>
    <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
      <a href={whatsappUrl(message)} target="_blank" rel="noopener" class="btn btn-primary" data-track="whatsapp-service">
        <BrandIcon name="whatsapp" class="size-[18px]" /> Pedir orçamento no WhatsApp
      </a>
      <a href={`/contato/?servico=${service.id}#orcamento`} class="btn btn-secondary">Formulário de orçamento <ArrowRight size={17} aria-hidden="true" /></a>
    </div>
  </PageHero>

  <div class="container-x grid gap-12 py-12 sm:py-16 lg:grid-cols-12 lg:gap-16">
    <article class="min-w-0 lg:col-span-8">
      <!-- Introdução -->
      <div class="prose-earth">
        <Content />
      </div>

      <!-- Para quem é -->
      <section class="mt-14" aria-labelledby="para-quem">
        <p class="label">Público</p>
        <h2 id="para-quem" class="mt-3 text-2xl sm:text-3xl">Para quem é</h2>
        <ul class="mt-6 grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2">
          {
            data.audience.map((a) => (
              <li class="flex gap-3 bg-white p-4">
                <span class="mt-2 size-1.5 shrink-0 rounded-full bg-leaf-500" aria-hidden="true" />
                <span>{a}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Como funciona -->
      <section class="mt-14" aria-labelledby="como-funciona">
        <p class="label">Processo</p>
        <h2 id="como-funciona" class="mt-3 text-2xl sm:text-3xl">Como funciona</h2>
        <ol class="mt-6 border-t border-line">
          {
            data.steps.map((s, i) => (
              <li class="grid grid-cols-[2.5rem_1fr] gap-x-3 border-b border-line py-5">
                <span class="font-mono text-xs leading-7 text-brand-600">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3 class="text-lg">{s.title}</h3>
                  <p class="mt-1 text-muted">{s.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- Legislação -->
      <section class="mt-14" aria-labelledby="legislacao">
        <p class="label">Base legal</p>
        <h2 id="legislacao" class="mt-3 text-2xl sm:text-3xl">Legislação e órgãos envolvidos</h2>
        <ul class="mt-6 space-y-3">
          {
            data.legislation.map((l) => (
              <li class="panel flex gap-4 p-5">
                <Scale size={20} class="mt-0.5 shrink-0 text-brand-500" aria-hidden="true" />
                <div>
                  <p class="font-semibold tracking-tight">{l.name}</p>
                  <p class="mt-1 text-[15px] leading-relaxed text-muted">{l.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-xs text-muted">As referências legais têm caráter informativo. A análise de cada caso considera a legislação vigente e as exigências do órgão competente.</p>
      </section>

      <!-- Benefícios e riscos -->
      <section class="mt-14" aria-labelledby="beneficios">
        <p class="label">Por que fazer</p>
        <h2 id="beneficios" class="mt-3 text-2xl sm:text-3xl">Benefícios e riscos de não ter</h2>
        <div class="mt-6 grid gap-px overflow-hidden rounded-xl border border-line bg-line md:grid-cols-2">
          <div class="bg-white p-6">
            <h3 class="text-lg">Benefícios</h3>
            <ul class="mt-4 space-y-3">
              {
                data.benefits.map((b) => (
                  <li class="flex gap-3">
                    <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded bg-leaf-400 text-brand-950"><Check size={13} stroke-width={3} aria-hidden="true" /></span>
                    <span>{b}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="bg-white p-6">
            <h3 class="text-lg">Riscos de não ter</h3>
            <ul class="mt-4 space-y-3">
              {
                data.risks.map((r) => (
                  <li class="flex gap-3">
                    <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded bg-warn-bg text-warn"><X size={13} stroke-width={3} aria-hidden="true" /></span>
                    <span>{r}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section class="mt-14" aria-labelledby="faq">
        <p class="label">FAQ</p>
        <h2 id="faq" class="mt-3 mb-6 text-2xl sm:text-3xl">Perguntas frequentes sobre {data.title}</h2>
        <Faq items={data.faq} />
      </section>
    </article>

    <!-- Lateral: CTA de orçamento -->
    <aside class="lg:col-span-4" aria-label="Solicitar orçamento">
      <div class="panel overflow-hidden lg:sticky lg:top-28">
        <div class="flex items-center gap-3 border-b border-line bg-mist px-5 py-3">
          <Icon name={data.icon} size={18} class="text-brand-600" />
          <span class="font-mono text-[11px] tracking-[0.14em] text-muted uppercase">Orçamento</span>
        </div>
        <div class="p-5">
          <p class="text-lg font-semibold tracking-tight">Orçamento de {data.title}</p>
          <p class="mt-2 text-sm text-muted">Atendemos {site.areaServed.join(', ')}. Conte sobre a sua empresa e receba uma proposta.</p>
          <a href={whatsappUrl(message)} target="_blank" rel="noopener" class="btn btn-primary mt-5 w-full">
            <BrandIcon name="whatsapp" class="size-[18px]" /> Falar no WhatsApp
          </a>
          <a href={`tel:${site.contact.phoneHref}`} class="btn btn-secondary mt-2 w-full"><Phone size={17} aria-hidden="true" /> {site.contact.phoneDisplay}</a>
        </div>
      </div>
    </aside>
  </div>

  <!-- Serviços relacionados -->
  <section class="border-t border-line bg-mist py-14 sm:py-20" aria-labelledby="relacionados">
    <div class="container-x">
      <p class="label">Relacionados</p>
      <h2 id="relacionados" class="mt-3 text-2xl sm:text-3xl">Serviços relacionados</h2>
      <div class="mt-8 border-t border-line">
        {related.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <CtaBanner title={`Solicite um orçamento de ${data.title}.`} message={message} />
</BaseLayout>
