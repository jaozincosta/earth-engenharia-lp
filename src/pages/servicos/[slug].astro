---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { Check, Phone, ArrowUpRight } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import BrandIcon from '@/components/BrandIcon.astro';
import Faq from '@/components/Faq.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import { categories, site, whatsappUrl } from '@/config/site';
import { getServices, serviceUrl, type Service } from '@/lib/services';

export const getStaticPaths = (async () => {
  const services = await getServices();
  return services.map((service) => ({ params: { slug: service.id }, props: { service, all: services } }));
}) satisfies GetStaticPaths;

interface Props {
  service: Service;
  all: Service[];
}

const { service, all } = Astro.props;
const { data } = service;
const { Content } = await render(service);
const cat = categories[data.category];
const url = new URL(serviceUrl(service), Astro.site).href;
const shortName = data.title.split(' – ')[0];

const related = [
  ...all.filter((s) => s.id !== service.id && s.data.category === data.category),
  ...all.filter((s) => s.id !== service.id && s.data.category !== data.category),
].slice(0, 4);

const message = `Olá! Vim pelo site e gostaria de um orçamento para: ${data.title}.`;

const schema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: data.title,
    serviceType: data.title,
    description: data.seoDescription,
    url,
    category: cat.label,
    provider: { '@id': new URL('/#organizacao', Astro.site).href },
    areaServed: site.areaServed.map((name) => ({ '@type': 'City', name })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Serviços', item: new URL('/servicos/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: data.title, item: url },
    ],
  },
];
if (data.faq.length) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: data.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
---

<BaseLayout title={data.seoTitle} description={data.seoDescription} schema={schema}>
  <PageHero
    label={cat.label}
    title={data.title}
    lead={data.summary}
    crumbs={[{ label: 'Serviços', href: '/servicos/' }, { label: shortName, href: serviceUrl(service) }]}
  >
    <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
      <a href={whatsappUrl(message)} target="_blank" rel="noopener" class="btn btn-primary" data-track="whatsapp-service">
        <BrandIcon name="whatsapp" class="size-[18px]" /> Pedir orçamento
      </a>
      <a href={`tel:${site.contact.phoneHref}`} class="btn btn-secondary"><Phone size={17} aria-hidden="true" /> {site.contact.phoneDisplay}</a>
    </div>
  </PageHero>

  <div class="container-x grid gap-12 py-12 sm:py-16 lg:grid-cols-12 lg:gap-16">
    <article class="lg:col-span-8">
      <div class="prose-earth" data-reveal>
        <Content />
      </div>

      {
        data.deliverables.length > 0 && (
          <section class="mt-14" aria-labelledby="entregas" data-reveal>
            <p class="label">Escopo</p>
            <h2 id="entregas" class="mt-3 text-2xl sm:text-3xl">O que está incluído</h2>
            <ol class="mt-6 border-t border-line">
              {data.deliverables.map((d, i) => (
                <li class="flex gap-4 border-b border-line py-4">
                  <span class="font-mono text-xs leading-6 text-brand-600">{String(i + 1).padStart(2, '0')}</span>
                  <span class="text-ink/90">{d}</span>
                </li>
              ))}
            </ol>
          </section>
        )
      }

      {
        data.benefits.length > 0 && (
          <section class="mt-14" aria-labelledby="beneficios">
            <p class="label" data-reveal>Benefícios</p>
            <h2 id="beneficios" class="mt-3 text-2xl sm:text-3xl" data-reveal>Por que fazer com a EARTH</h2>
            <div class="mt-6 grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2">
              {data.benefits.map((b) => (
                <div class="bg-white p-5" data-reveal>
                  <span class="grid size-6 place-items-center rounded bg-leaf-400 text-brand-950">
                    <Check size={14} stroke-width={3} aria-hidden="true" />
                  </span>
                  <h3 class="mt-4 text-lg">{b.title}</h3>
                  <p class="mt-1 text-[15px] leading-relaxed text-muted">{b.text}</p>
                </div>
              ))}
            </div>
          </section>
        )
      }

      {
        data.faq.length > 0 && (
          <section class="mt-14" aria-labelledby="faq" data-reveal>
            <p class="label">FAQ</p>
            <h2 id="faq" class="mt-3 mb-6 text-2xl sm:text-3xl">Perguntas frequentes sobre {shortName}</h2>
            <Faq items={data.faq} />
          </section>
        )
      }
    </article>

    <!-- Ficha técnica -->
    <aside class="lg:col-span-4">
      <div class="space-y-4 lg:sticky lg:top-28">
        <div class="panel overflow-hidden" data-reveal>
          <div class="flex items-center gap-3 border-b border-line bg-mist px-5 py-3">
            <Icon name={data.icon} size={18} class="text-brand-600" />
            <span class="font-mono text-[11px] tracking-[0.14em] text-muted uppercase">Ficha técnica</span>
          </div>
          <dl class="divide-y divide-line text-sm">
            <div class="flex justify-between gap-4 px-5 py-3"><dt class="text-muted">Área</dt><dd class="text-right font-medium">{cat.label}</dd></div>
            <div class="flex justify-between gap-4 px-5 py-3"><dt class="text-muted">Atendimento</dt><dd class="text-right font-medium">{site.address.city} e Grande SP</dd></div>
            <div class="flex justify-between gap-4 px-5 py-3"><dt class="text-muted">Entregáveis</dt><dd class="text-right font-medium">{data.deliverables.length} itens</dd></div>
            {
              data.audience.length > 0 && (
                <div class="px-5 py-3">
                  <dt class="text-muted">Para quem é</dt>
                  <dd class="mt-2 space-y-1.5">
                    {data.audience.map((a) => (
                      <span class="flex gap-2">
                        <span class="mt-2 size-1 shrink-0 rounded-full bg-leaf-500" />
                        {a}
                      </span>
                    ))}
                  </dd>
                </div>
              )
            }
            <div class="px-5 py-3">
              <dt class="text-muted">Termos relacionados</dt>
              <dd class="mt-2 flex flex-wrap gap-1.5">{data.keywords.slice(0, 8).map((k) => <span class="chip">{k}</span>)}</dd>
            </div>
          </dl>
          <div class="border-t border-line p-4">
            <a href={whatsappUrl(message)} target="_blank" rel="noopener" class="btn btn-primary w-full">
              <BrandIcon name="whatsapp" class="size-[18px]" /> Falar com especialista
            </a>
          </div>
        </div>
      </div>
    </aside>
  </div>

  <section class="border-t border-line bg-mist py-14 sm:py-20" aria-labelledby="relacionados">
    <div class="container-x">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="label">Relacionados</p>
          <h2 id="relacionados" class="mt-3 text-2xl sm:text-3xl">Outros serviços</h2>
        </div>
        <a href="/servicos/" class="hidden items-center gap-1 font-medium text-brand-600 sm:inline-flex">Ver catálogo <ArrowUpRight size={16} aria-hidden="true" /></a>
      </div>
      <div class="mt-8 border-t border-line">
        {related.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <CtaBanner title={`Fale com a EARTH sobre ${shortName}.`} message={message} />
</BaseLayout>
