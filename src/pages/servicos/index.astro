---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ServiceFilter from '@/components/ServiceFilter.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import BrandIcon from '@/components/BrandIcon.astro';
import { site, whatsappUrl } from '@/config/site';
import { getServices, serviceUrl } from '@/lib/services';
import { sectionImages } from '@/config/media';

const services = await getServices();

const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Serviços da ${site.name}`,
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.data.title,
    url: new URL(serviceUrl(s), Astro.site).href,
  })),
};
const crumbs = [{ label: 'Serviços', href: '/servicos/' }];
---

<BaseLayout
  title="Serviços de Engenharia Ambiental e SST em SP | EARTH"
  description="Conheça os serviços da EARTH em SP: licenciamento ambiental, outorga, PGRS, PGR, áreas contaminadas, cursos NR 33 e 35 e palestras. Solicite um orçamento."
  schema={[listSchema]}
  breadcrumbs={crumbs}
>
  <PageHero
    label="Catálogo de serviços"
    title="Serviços de engenharia ambiental e segurança do trabalho"
    lead={`${site.slogans.partner} Filtre por categoria ou busque pelo serviço que você precisa.`}
    crumbs={crumbs}
    image={sectionImages.aerea}
  >
    <a href={whatsappUrl('Olá! Vim pelo site da EARTH Engenharia e preciso de ajuda para saber qual serviço minha empresa precisa.')} target="_blank" rel="noopener" class="btn btn-primary">
      <BrandIcon name="whatsapp" class="size-[18px]" /> Não sei qual preciso
    </a>
  </PageHero>

  <section class="section pt-10 sm:pt-12" aria-label="Lista de serviços">
    <div class="container-x">
      <ServiceFilter services={services} />
    </div>
  </section>

  <CtaBanner title="Não sabe qual serviço sua empresa precisa?" text="Conte sobre a sua atividade e indicamos o caminho — licença, plano, programa, investigação ou treinamento." />
</BaseLayout>
