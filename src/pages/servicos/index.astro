---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ServiceFilter from '@/components/ServiceFilter.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import BrandIcon from '@/components/BrandIcon.astro';
import { site, whatsappUrl } from '@/config/site';
import { getServices, serviceUrl } from '@/lib/services';

const services = await getServices();

const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Serviços da ${site.name}`,
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.data.title,
    url: new URL(serviceUrl(s), Astro.site).href,
  })),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Serviços', item: new URL('/servicos/', Astro.site).href },
  ],
};
---

<BaseLayout
  title="Serviços de Engenharia Ambiental e Segurança do Trabalho em SP"
  description={`Serviços da ${site.name} em São Paulo: licenciamento CETESB, PGRS, outorga, estudos ambientais, PGR, LTCAT, treinamentos de NRs, AVCB/CLCB e eSocial SST.`}
  schema={[listSchema, breadcrumbSchema]}
>
  <PageHero
    label="Catálogo de serviços"
    title="Serviços de engenharia ambiental e segurança do trabalho"
    lead={`${site.slogans.partner} Escolha uma área ou busque pelo documento que você precisa.`}
    crumbs={[{ label: 'Serviços', href: '/servicos/' }]}
  >
    <a href={whatsappUrl()} target="_blank" rel="noopener" class="btn btn-primary">
      <BrandIcon name="whatsapp" class="size-[18px]" /> Não sei qual preciso
    </a>
  </PageHero>

  <section class="section pt-10 sm:pt-12">
    <div class="container-x">
      <ServiceFilter services={services} />
    </div>
  </section>

  <CtaBanner title="Não sabe qual serviço sua empresa precisa?" text="Conte sobre sua atividade e indicamos o caminho — licença, laudo, programa ou treinamento." />
</BaseLayout>
