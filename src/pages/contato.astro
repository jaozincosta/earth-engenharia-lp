---
import { Mail, MapPin, Phone, Clock, Send, ArrowUpRight } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import BrandIcon from '@/components/BrandIcon.astro';
import { site, whatsappUrl } from '@/config/site';
import { getServices } from '@/lib/services';

const services = await getServices();
const { contact: c, address: a } = site;
const addressLine = [a.street, a.district].filter(Boolean).join(' – ');
const mapQuery = encodeURIComponent([a.street, a.district, `${a.city} - ${a.state}`].filter(Boolean).join(', '));

const contactPage = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Contato — ${site.name}`,
  url: new URL('/contato/', Astro.site).href,
};

const field = 'mt-1.5 h-12 w-full rounded-lg border border-line bg-white px-3.5 text-base focus:border-brand-500 focus:outline-none';
---

<BaseLayout
  title={`Contato e Orçamento — ${site.name}`}
  description={`Fale com a ${site.name} pelo WhatsApp ${c.phoneDisplay}, telefone ou e-mail e solicite um orçamento de serviços ambientais e de segurança do trabalho em São Paulo/SP.`}
  schema={[contactPage]}
>
  <PageHero
    label="Contato"
    title="Fale com a EARTH."
    lead="Conte o que sua empresa precisa. O jeito mais rápido é pelo WhatsApp."
    crumbs={[{ label: 'Contato', href: '/contato/' }]}
  />

  <section class="section pt-10 sm:pt-14">
    <div class="container-x grid gap-10 lg:grid-cols-12">
      <!-- Canais -->
      <div class="lg:col-span-5">
        <div class="panel divide-y divide-line overflow-hidden">
          <a href={whatsappUrl()} target="_blank" rel="noopener" class="group flex items-center gap-4 p-5 transition-colors hover:bg-mist" data-track="whatsapp-contato">
            <span class="grid size-11 shrink-0 place-items-center rounded-lg bg-[#25D366] text-white"><BrandIcon name="whatsapp" class="size-6" /></span>
            <span class="flex-1">
              <span class="block font-semibold">WhatsApp</span>
              <span class="font-mono text-sm text-muted">{c.phoneDisplay}</span>
            </span>
            <ArrowUpRight size={18} class="text-brand-400 group-hover:text-brand-600" aria-hidden="true" />
          </a>
          <a href={`tel:${c.phoneHref}`} class="group flex items-center gap-4 p-5 transition-colors hover:bg-mist">
            <span class="grid size-11 shrink-0 place-items-center rounded-lg border border-line text-brand-600"><Phone size={20} aria-hidden="true" /></span>
            <span class="flex-1"><span class="block font-semibold">Telefone</span><span class="font-mono text-sm text-muted">{c.phoneDisplay}</span></span>
            <ArrowUpRight size={18} class="text-brand-400 group-hover:text-brand-600" aria-hidden="true" />
          </a>
          <a href={`mailto:${c.email}`} class="group flex items-center gap-4 p-5 transition-colors hover:bg-mist">
            <span class="grid size-11 shrink-0 place-items-center rounded-lg border border-line text-brand-600"><Mail size={20} aria-hidden="true" /></span>
            <span class="min-w-0 flex-1"><span class="block font-semibold">E-mail</span><span class="block font-mono text-sm break-all text-muted">{c.email}</span></span>
            <ArrowUpRight size={18} class="text-brand-400 group-hover:text-brand-600" aria-hidden="true" />
          </a>
          <div class="flex items-start gap-4 p-5">
            <span class="grid size-11 shrink-0 place-items-center rounded-lg border border-line text-brand-600"><MapPin size={20} aria-hidden="true" /></span>
            <span>
              <span class="block font-semibold">Endereço</span>
              <span class="text-sm text-muted">{addressLine && <>{addressLine}<br /></>}{a.city}/{a.state}</span>
              <a href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`} target="_blank" rel="noopener" class="mt-1 block text-sm font-medium text-brand-600 underline decoration-leaf-400 underline-offset-4">Abrir no Google Maps</a>
            </span>
          </div>
          <div class="flex items-center gap-3 bg-mist px-5 py-4 font-mono text-xs text-muted">
            <Clock size={16} class="text-brand-500" aria-hidden="true" /> {site.hours.days}, {site.hours.open}–{site.hours.close}
          </div>
        </div>
      </div>

      <!-- Formulário → envia a mensagem pronta para o WhatsApp (sem backend) -->
      <div class="lg:col-span-7">
        <form id="contact-form" class="panel space-y-5 p-6 sm:p-8" novalidate>
          <div>
            <p class="label">Orçamento</p>
            <h2 class="mt-3 text-2xl">Solicite um orçamento</h2>
            <p class="mt-1 text-sm text-muted">Preencha e enviaremos sua mensagem pelo WhatsApp.</p>
          </div>
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="block">
              <span class="text-sm font-medium">Nome *</span>
              <input name="nome" required autocomplete="name" class={field} />
            </label>
            <label class="block">
              <span class="text-sm font-medium">Empresa</span>
              <input name="empresa" autocomplete="organization" class={field} />
            </label>
          </div>
          <label class="block">
            <span class="text-sm font-medium">Cidade</span>
            <input name="cidade" autocomplete="address-level2" class={field} />
          </label>
          <label class="block">
            <span class="text-sm font-medium">Serviço de interesse</span>
            <select name="servico" class={field}>
              <option value="">Não sei / preciso de orientação</option>
              {services.map((s) => <option value={s.data.title}>{s.data.title}</option>)}
            </select>
          </label>
          <label class="block">
            <span class="text-sm font-medium">Mensagem *</span>
            <textarea name="mensagem" required rows="4" class="mt-1.5 w-full rounded-lg border border-line bg-white p-3.5 text-base focus:border-brand-500 focus:outline-none" placeholder="Conte um pouco sobre sua atividade e necessidade"></textarea>
          </label>
          <p id="form-error" class="hidden text-sm font-medium text-red-700" role="alert">Preencha seu nome e a mensagem.</p>
          <button type="submit" class="btn btn-primary w-full sm:w-auto">
            <Send size={17} aria-hidden="true" /> Enviar pelo WhatsApp
          </button>
          <p class="text-xs text-muted">Seus dados são usados apenas para responder ao seu contato. Veja nossa <a href="/politica-de-privacidade/" class="underline">política de privacidade</a>.</p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ phone: c.whatsapp }}>
  const form = document.getElementById('contact-form');
  const err = document.getElementById('form-error');
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const nome = String(d.get('nome') || '').trim();
    const msg = String(d.get('mensagem') || '').trim();
    if (!nome || !msg) {
      err.classList.remove('hidden');
      return;
    }
    err.classList.add('hidden');
    const lines = [
      `Olá! Meu nome é ${nome}.`,
      d.get('empresa') && `Empresa: ${d.get('empresa')}`,
      d.get('cidade') && `Cidade: ${d.get('cidade')}`,
      d.get('servico') && `Serviço: ${d.get('servico')}`,
      '',
      msg,
    ].filter((l) => typeof l === 'string');
    window.open(`https://wa.me/${phone}?text=${encodeURIComponent(lines.join('\n'))}`, '_blank', 'noopener');
  });
</script>
