---
import { ArrowRight } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getServices, serviceUrl } from '@/lib/services';

const featured = (await getServices()).filter((s) => s.data.featured).slice(0, 4);
---

<BaseLayout title="Página não encontrada" description="A página que você procura não existe ou mudou de endereço." noindex>
  <section class="container-x py-20 text-center sm:py-28">
    <p class="font-mono text-7xl font-semibold text-brand-600">404</p>
    <h1 class="mt-4 text-3xl sm:text-4xl">Página não encontrada</h1>
    <p class="mx-auto mt-3 max-w-md text-muted">O endereço pode ter mudado. Que tal começar por um destes serviços?</p>
    <ul class="mx-auto mt-8 grid max-w-xl gap-2 text-left">
      {
        featured.map((s) => (
          <li>
            <a href={serviceUrl(s)} class="flex items-center justify-between rounded-lg border border-line p-4 font-medium hover:bg-mist">
              {s.data.title} <ArrowRight size={18} aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ul>
    <a href="/" class="btn btn-primary mt-8">Voltar ao início</a>
  </section>
</BaseLayout>
