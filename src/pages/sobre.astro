---
import { Picture } from 'astro:assets';
import { Leaf, ShieldCheck, Scale } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import { site } from '@/config/site';
import sobreImg from '@/assets/fotos/sobre.jpg';

// TODO: revisar missão, visão e valores com a direção da empresa.
const pillars = [
  { title: 'Missão', text: 'Oferecer soluções técnicas em meio ambiente e segurança do trabalho que mantenham nossos clientes em conformidade e operando com responsabilidade.' },
  { title: 'Visão', text: 'Ser referência em São Paulo como parceiro técnico integrado em sustentabilidade, segurança e conformidade.' },
  { title: 'Valores', text: 'Ética, rigor técnico, transparência, proximidade com o cliente e compromisso com as próximas gerações.' },
];

const areas = [
  { icon: Leaf, title: 'Meio Ambiente', text: 'Licenciamento CETESB, resíduos, recursos hídricos, estudos e monitoramento ambiental.' },
  { icon: ShieldCheck, title: 'Segurança do Trabalho', text: 'PGR, LTCAT, laudos de insalubridade e periculosidade e treinamentos de NRs.' },
  { icon: Scale, title: 'Conformidade', text: 'AVCB/CLCB, eSocial SST e gestão de requisitos legais.' },
];
---

<BaseLayout
  title="Sobre a EARTH Engenharia"
  description={`Conheça a ${site.name}: engenharia ambiental e segurança do trabalho em São Paulo/SP. ${site.slogans.main}.`}
>
  <PageHero label="Sobre" title={`${site.slogans.future}.`} lead={`${site.slogans.main}.`} crumbs={[{ label: 'Sobre', href: '/sobre/' }]} />

  <section class="section">
    <div class="container-x grid items-center gap-12 lg:grid-cols-12">
      <div class="lg:col-span-6" data-reveal>
        <p class="label">Quem somos</p>
        <h2 class="h-section mt-4">Engenharia que une meio ambiente, pessoas e resultados.</h2>
        <!-- TODO: substituir pelo texto institucional real (história, fundação, responsáveis técnicos e registros no CREA). -->
        <div class="prose-earth mt-6">
          <p>
            A <strong>{site.name}</strong> é uma empresa de engenharia ambiental e segurança do trabalho sediada em São Paulo, que ajuda
            organizações a cumprir a legislação, proteger pessoas e reduzir impactos — com soluções técnicas, práticas e sustentáveis.
          </p>
          <p>
            Atuamos de forma integrada: o mesmo time que conduz o seu licenciamento ambiental entende os riscos ocupacionais da sua
            operação. Isso significa informações coerentes, menos retrabalho e um único parceiro de confiança.
          </p>
        </div>
      </div>
      <div class="lg:col-span-6" data-reveal>
        <Picture
          src={sobreImg}
          formats={['avif', 'webp']}
          widths={[400, 700, 1000]}
          sizes="(min-width: 1024px) 45vw, 92vw"
          alt="Equipe técnica da EARTH Engenharia"
          class="aspect-[4/3] w-full rounded-xl object-cover"
        />
      </div>
    </div>
  </section>

  <section class="border-y border-line bg-mist">
    <div class="container-x grid md:grid-cols-3">
      {
        pillars.map((p, i) => (
          <div class:list={['py-10 md:pr-8', i > 0 && 'border-t border-line md:border-t-0 md:border-l md:pl-8']} data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <p class="font-mono text-xs text-brand-600">0{i + 1}</p>
            <h2 class="mt-3 text-2xl">{p.title}</h2>
            <p class="mt-3 text-muted">{p.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <div class="max-w-2xl" data-reveal>
        <p class="label">Áreas</p>
        <h2 class="h-section mt-4">{site.slogans.partner}</h2>
      </div>
      <div class="mt-10 grid gap-px overflow-hidden rounded-xl border border-line bg-line md:grid-cols-3">
        {
          areas.map((a) => (
            <div class="bg-white p-6" data-reveal>
              <a.icon size={24} class="text-brand-500" aria-hidden="true" />
              <h3 class="mt-5 text-xl">{a.title}</h3>
              <p class="mt-2 text-muted">{a.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
