---
import { Picture } from 'astro:assets';
import { Target, Eye, Check } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import { pillars, site } from '@/config/site';
import { organizationAbout } from '@/lib/schema';
import { sectionImages } from '@/config/media';

const crumbs = [{ label: 'Sobre', href: '/sobre/' }];
const { mission, vision, values } = site.institutional;
---

<BaseLayout
  title="Sobre a EARTH Engenharia – Missão, Visão e Valores"
  description="Conheça a EARTH Engenharia, empresa de engenharia ambiental e segurança do trabalho em São Paulo: missão, visão, valores e diferenciais. Fale com a gente."
  schema={[organizationAbout(Astro.site!)]}
  breadcrumbs={crumbs}
>
  <PageHero label="Sobre a EARTH" title="Engenharia responsável, soluções para o futuro" lead={`${site.slogans.main}. ${site.slogans.partner}`} crumbs={crumbs} image={sectionImages.natureza} />

  <section class="section" aria-labelledby="quem-somos">
    <div class="container-x grid items-center gap-12 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <p class="label">Quem somos</p>
        <h2 id="quem-somos" class="h-section mt-4">Empresa de engenharia ambiental e segurança do trabalho em São Paulo</h2>
        <!-- TODO: complementar com a história real da empresa, responsáveis técnicos e registros profissionais. -->
        <div class="prose-earth mt-6">
          <p>
            A <strong>{site.name}</strong> oferece soluções em meio ambiente, segurança do trabalho e conformidade legal para empresas de
            {site.address.city} e região — do licenciamento ambiental e da gestão de resíduos ao gerenciamento de riscos ocupacionais e à
            capacitação das equipes.
          </p>
          <p>Nosso trabalho une conhecimento técnico, presença em campo e atenção à realidade de cada cliente. {site.slogans.future}.</p>
        </div>
      </div>
      <div class="lg:col-span-6">
        <Picture
          src={sectionImages.saoPaulo.src}
          formats={['avif', 'webp']}
          widths={[400, 700, 1000]}
          sizes="(min-width: 1024px) 45vw, 100vw"
          alt={sectionImages.saoPaulo.alt}
          class="aspect-[4/3] w-full rounded-2xl border border-line object-cover shadow-[0_30px_80px_-30px_rgb(122_201_67/0.35)]"
        />
      </div>
    </div>
  </section>

  <section class="border-y border-line bg-panel" aria-label="Missão e visão">
    <div class="container-x grid md:grid-cols-2">
      <div class="py-10 md:pr-10">
        <Target size={24} class="text-leaf-400" aria-hidden="true" />
        <h2 class="mt-4 text-2xl">Missão</h2>
        <p class="mt-3 text-lg leading-relaxed text-muted">{mission}</p>
      </div>
      <div class="border-t border-line py-10 md:border-t-0 md:border-l md:pl-10">
        <Eye size={24} class="text-leaf-400" aria-hidden="true" />
        <h2 class="mt-4 text-2xl">Visão</h2>
        <p class="mt-3 text-lg leading-relaxed text-muted">{vision}</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="valores">
    <div class="container-x">
      <p class="label">Valores</p>
      <h2 id="valores" class="h-section mt-4">Nossos valores</h2>
      <ul class="mt-10 grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
        {
          values.map((v, i) => (
            <li class="flex items-center gap-4 bg-panel p-6 transition-colors hover:bg-brand-900">
              <span class="font-mono text-xs text-leaf-400">{String(i + 1).padStart(2, '0')}</span>
              <span class="text-lg font-medium tracking-tight">{v}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-t border-line bg-panel section" aria-labelledby="diferenciais">
    <div class="container-x">
      <p class="label">Diferenciais</p>
      <h2 id="diferenciais" class="h-section mt-4">O que nos diferencia</h2>
      <ul class="mt-8 flex flex-wrap gap-2">
        {pillars.map((p) => <li class="chip text-xs"><Check size={12} aria-hidden="true" />{p}</li>)}
      </ul>
      <!-- Diferenciais editáveis em src/config/site.ts (placeholders) -->
      <ul class="mt-8 grid gap-4 md:grid-cols-3">
        {
          site.differentials.map((d) => (
            <li class="panel p-6">
              <h3 class="text-lg">{d.title}</h3>
              <p class="mt-2 text-muted">{d.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
