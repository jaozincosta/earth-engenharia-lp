---
import { Picture } from 'astro:assets';
import {
  ArrowRight,
  BadgeCheck,
  ClipboardCheck,
  Factory,
  HardHat,
  Leaf,
  MapPin,
  Construction,
  Store,
  Tractor,
  Stethoscope,
  Building,
  Search,
  FileText,
  Handshake,
  RefreshCw,
  ShieldCheck,
  Layers,
} from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BrandIcon from '@/components/BrandIcon.astro';
import ServiceFilter from '@/components/ServiceFilter.astro';
import Faq from '@/components/Faq.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import { site, whatsappUrl, categories } from '@/config/site';
import { getServices } from '@/lib/services';
import heroImg from '@/assets/fotos/equipe-campo.jpg';
import ambientalImg from '@/assets/fotos/licenciamento.jpg';
import segurancaImg from '@/assets/fotos/seguranca.jpg';

const services = await getServices();

const areaIcons = { 'meio-ambiente': Leaf, 'seguranca-do-trabalho': HardHat, conformidade: ClipboardCheck } as const;

const differentials = [
  { icon: Layers, title: 'Tudo em um só parceiro', text: 'Meio ambiente, segurança do trabalho e conformidade integrados — menos fornecedores, menos ruído.' },
  { icon: BadgeCheck, title: 'Responsabilidade técnica', text: 'Laudos, projetos e estudos assinados por profissionais habilitados, com ART.' },
  { icon: MapPin, title: 'Atendimento em campo', text: 'Vamos até a sua operação para entender a realidade antes de entregar qualquer documento.' },
  { icon: RefreshCw, title: 'Gestão de prazos', text: 'Controlamos vencimentos de licenças, laudos e treinamentos para nada ficar para trás.' },
];

const steps = [
  { icon: Search, title: 'Diagnóstico', text: 'Entendemos sua atividade, documentos existentes e pendências.' },
  { icon: FileText, title: 'Proposta clara', text: 'Escopo, prazos e investimento definidos, sem surpresas.' },
  { icon: Handshake, title: 'Execução técnica', text: 'Levantamentos em campo, elaboração e protocolo dos documentos.' },
  { icon: ShieldCheck, title: 'Acompanhamento', text: 'Condicionantes, renovações e atualizações sob controle.' },
];

const segments = [
  { icon: Factory, label: 'Indústrias' },
  { icon: Construction, label: 'Construção civil' },
  { icon: Store, label: 'Comércio e serviços' },
  { icon: Tractor, label: 'Agronegócio' },
  { icon: Stethoscope, label: 'Saúde' },
  { icon: Building, label: 'Condomínios e empreendimentos' },
];

const faq = [
  {
    q: 'A EARTH Engenharia atende quais regiões?',
    a: `Atendemos empresas em ${site.areaServed.slice(0, -1).join(', ')} e região, com visitas técnicas presenciais. Para outras localidades, consulte disponibilidade.`,
  },
  {
    q: 'Preciso contratar empresas diferentes para meio ambiente e segurança do trabalho?',
    a: 'Não. A EARTH integra as duas áreas: licenças, PGRS, PGR, LTCAT, treinamentos e eSocial ficam com um único parceiro, com informações consistentes entre si.',
  },
  {
    q: 'Como funciona o orçamento?',
    a: 'Você nos chama no WhatsApp ou pelo formulário, fazemos algumas perguntas sobre a atividade e, se necessário, uma visita técnica. Em seguida enviamos uma proposta com escopo, prazo e investimento.',
  },
  {
    q: 'Vocês emitem ART?',
    a: 'Sim. Os serviços técnicos que exigem responsabilidade técnica são acompanhados da Anotação de Responsabilidade Técnica (ART) do profissional habilitado.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout
  title={`Engenharia Ambiental e Segurança do Trabalho em ${site.address.city}`}
  description={`${site.name}: licenciamento ambiental, PGRS, PGR, LTCAT, laudos, treinamentos de NRs e prevenção de incêndio em ${site.address.city}/${site.address.state} e região. Solicite um orçamento.`}
  schema={[faqSchema]}
>
  <!-- HERO -->
  <section class="bg-hero relative isolate overflow-hidden text-white">
    <div class="bg-grid pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="container-x grid items-center gap-12 pt-12 pb-16 sm:pt-16 lg:grid-cols-12 lg:gap-8 lg:pt-24 lg:pb-28">
      <div class="lg:col-span-7">
        <p class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-semibold tracking-wide text-leaf-200 backdrop-blur">
          <span class="size-1.5 rounded-full bg-leaf-400"></span>{site.slogans.main}
        </p>
        <h1 class="mt-5 text-[2.1rem] leading-[1.1] text-white sm:text-5xl lg:text-6xl">
          Engenharia ambiental e <span class="text-gradient">segurança do trabalho</span> para sua empresa operar em conformidade
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/80">
          {site.slogans.partner} Licenças, resíduos, laudos, programas de SST e treinamentos com responsabilidade técnica e atendimento em campo.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={whatsappUrl()} target="_blank" rel="noopener" class="btn btn-primary" data-track="whatsapp-hero">
            <BrandIcon name="whatsapp" /> Solicitar orçamento
          </a>
          <a href="#servicos" class="btn btn-ghost">Ver serviços <ArrowRight size={18} aria-hidden="true" /></a>
        </div>
        <ul class="mt-10 grid grid-cols-1 gap-3 text-sm text-white/80 sm:grid-cols-3">
          {
            ['Profissionais habilitados com ART', 'Atendimento presencial', 'Ambiental + SST integrados'].map((t) => (
              <li class="flex items-center gap-2">
                <BadgeCheck size={18} class="shrink-0 text-leaf-400" aria-hidden="true" />
                {t}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="relative lg:col-span-5">
        <div class="relative overflow-hidden rounded-[2rem] border border-white/15 shadow-2xl">
          <Picture
            src={heroImg}
            formats={['avif', 'webp']}
            widths={[400, 640, 900]}
            sizes="(min-width: 1024px) 40vw, 92vw"
            alt="Equipe da EARTH Engenharia realizando vistoria técnica em campo"
            loading="eager"
            fetchpriority="high"
            class="aspect-[4/3] w-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-brand-950/60 via-transparent" aria-hidden="true"></div>
        </div>
        <div class="glass absolute -bottom-6 left-4 right-4 flex items-center gap-3 rounded-2xl p-4 text-ink sm:left-auto sm:right-6 sm:w-72 lg:-left-8 lg:right-auto motion-safe:animate-float">
          <span class="icon-badge size-11"><Leaf size={22} aria-hidden="true" /></span>
          <div>
            <p class="text-sm font-bold text-brand-900">{site.slogans.future}</p>
            <p class="text-xs text-muted">Soluções técnicas e sustentáveis</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ÁREAS DE ATUAÇÃO -->
  <section class="section pb-0" aria-labelledby="areas-title">
    <div class="container-x">
      <div class="max-w-2xl" data-reveal>
        <span class="eyebrow">Áreas de atuação</span>
        <h2 id="areas-title" class="mt-4 text-3xl sm:text-4xl">Meio ambiente, segurança e conformidade em um só parceiro</h2>
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-3 md:gap-5">
        {
          Object.entries(categories).map(([key, c], i) => {
            const Ico = areaIcons[key as keyof typeof areaIcons];
            const count = services.filter((s) => s.data.category === key).length;
            return (
              <a
                href={`/servicos/?area=${key}`}
                class="card card-hover group relative overflow-hidden p-6"
                data-reveal
                style={`--reveal-delay:${i * 90}ms`}
              >
                <div class="absolute -top-16 -right-16 size-40 rounded-full bg-leaf-100 opacity-60 transition group-hover:scale-125" aria-hidden="true" />
                <span class="icon-badge relative">
                  <Ico size={24} aria-hidden="true" />
                </span>
                <h3 class="relative mt-5 text-xl">{c.label}</h3>
                <p class="relative mt-2 text-muted">{c.description}</p>
                <span class="relative mt-5 inline-flex items-center gap-1 text-sm font-semibold text-brand-600">
                  {count} serviços <ArrowRight size={16} class="transition group-hover:translate-x-1" aria-hidden="true" />
                </span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- SERVIÇOS -->
  <section id="servicos" class="section" aria-labelledby="servicos-title">
    <div class="container-x">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between" data-reveal>
        <div class="max-w-2xl">
          <span class="eyebrow">Serviços</span>
          <h2 id="servicos-title" class="mt-4 text-3xl sm:text-4xl">Encontre o serviço que sua empresa precisa</h2>
          <p class="mt-3 text-lg text-muted">Filtre por área ou busque pelo nome do documento.</p>
        </div>
        <a href="/servicos/" class="btn btn-outline self-start md:self-auto">Todos os serviços <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
      <div class="mt-8">
        <ServiceFilter services={services} />
      </div>
    </div>
  </section>

  <!-- POR QUE A EARTH -->
  <section class="section bg-mist" aria-labelledby="dif-title">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2">
      <div class="grid grid-cols-2 gap-3 sm:gap-4" data-reveal>
        <Picture
          src={ambientalImg}
          formats={['avif', 'webp']}
          widths={[320, 560]}
          sizes="(min-width: 1024px) 24vw, 46vw"
          alt="Vistoria ambiental realizada pela EARTH Engenharia"
          class="aspect-[3/4] w-full rounded-3xl object-cover"
        />
        <Picture
          src={segurancaImg}
          formats={['avif', 'webp']}
          widths={[320, 560]}
          sizes="(min-width: 1024px) 24vw, 46vw"
          alt="Inspeção de segurança do trabalho em campo"
          class="mt-10 aspect-[3/4] w-full rounded-3xl object-cover"
        />
      </div>
      <div>
        <div data-reveal>
          <span class="eyebrow">Por que a EARTH</span>
          <h2 id="dif-title" class="mt-4 text-3xl sm:text-4xl">Confiança técnica do diagnóstico à renovação</h2>
          <p class="mt-4 text-lg text-muted">
            Unimos engenharia, legislação e presença em campo para entregar documentos que funcionam na prática — e uma operação que dorme tranquila.
          </p>
        </div>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2">
          {
            differentials.map((d, i) => (
              <li class="card p-5" data-reveal style={`--reveal-delay:${i * 80}ms`}>
                <d.icon size={22} class="text-leaf-500" aria-hidden="true" />
                <h3 class="mt-3 text-base">{d.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-muted">{d.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- COMO TRABALHAMOS -->
  <section class="section" aria-labelledby="proc-title">
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <span class="eyebrow">Como trabalhamos</span>
        <h2 id="proc-title" class="mt-4 text-3xl sm:text-4xl">Um processo simples, do primeiro contato à conformidade</h2>
      </div>
      <ol class="relative mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((s, i) => (
            <li class="card relative p-6" data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <span class="absolute top-5 right-5 text-4xl font-extrabold text-brand-100" aria-hidden="true">
                0{i + 1}
              </span>
              <span class="icon-badge">
                <s.icon size={22} aria-hidden="true" />
              </span>
              <h3 class="mt-5 text-lg">{s.title}</h3>
              <p class="mt-2 text-[15px] text-muted">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- SEGMENTOS -->
  <section class="bg-brand-900 py-14 text-white" aria-labelledby="seg-title">
    <div class="container-x">
      <h2 id="seg-title" class="text-center text-xl font-semibold text-white sm:text-2xl" data-reveal>Segmentos que atendemos</h2>
      <ul class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
        {
          segments.map((s, i) => (
            <li class="glass-dark flex flex-col items-center gap-2 rounded-2xl p-4 text-center text-sm font-medium" data-reveal style={`--reveal-delay:${i * 60}ms`}>
              <s.icon size={26} class="text-leaf-400" aria-hidden="true" />
              {s.label}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" aria-labelledby="faq-title">
    <div class="container-x grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4" data-reveal>
        <span class="eyebrow">Dúvidas frequentes</span>
        <h2 id="faq-title" class="mt-4 text-3xl sm:text-4xl">Perguntas frequentes</h2>
        <p class="mt-3 text-muted">Não encontrou sua resposta? <a href="/contato/" class="font-semibold text-brand-600 underline decoration-leaf-400 underline-offset-4">Fale com a gente</a>.</p>
      </div>
      <div class="lg:col-span-8" data-reveal>
        <Faq items={faq} />
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
