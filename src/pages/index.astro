---
import { Picture, getImage } from 'astro:assets';
import { ArrowRight, ArrowUpRight, Leaf, Scale, HeartHandshake, SlidersHorizontal, Search, ClipboardList, Wrench, ShieldCheck, Phone } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BrandIcon from '@/components/BrandIcon.astro';
import ServiceGridCard from '@/components/ServiceGridCard.astro';
import Faq from '@/components/Faq.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import { pillars, site, whatsappUrl } from '@/config/site';
import { getServices } from '@/lib/services';
import { faqPage } from '@/lib/schema';
import heroImg from '@/assets/fotos/equipe-campo.jpg';

const services = await getServices();

// Imagem do hero (LCP): mesmos parâmetros no <Picture> e no preload.
const heroWidths = [400, 640, 900, 1200];
const heroSizes = '(min-width: 1024px) 45vw, 100vw';
const heroAvif = await getImage({ src: heroImg, format: 'avif', widths: heroWidths });
const preloadImage = {
  src: heroAvif.src,
  srcset: heroAvif.srcSet.attribute,
  sizes: heroSizes,
  type: 'image/avif',
};

const pillarIcons = [Leaf, Scale, HeartHandshake, SlidersHorizontal];
const pillarTexts = [
  'Soluções técnicas que reduzem impactos e protegem os recursos naturais.',
  'Licenças, programas e documentos em dia com a legislação.',
  'Segurança e valorização da vida em cada atividade.',
  'Cada projeto desenhado para a realidade da sua empresa.',
];

const steps = [
  { icon: Search, title: 'Diagnóstico', text: 'Entendemos a sua atividade, visitamos o local e mapeamos as obrigações ambientais e de segurança do trabalho.' },
  { icon: ClipboardList, title: 'Planejamento', text: 'Definimos escopo, etapas, prazos e responsáveis em uma proposta clara.' },
  { icon: Wrench, title: 'Execução', text: 'Levantamentos em campo, elaboração dos documentos, treinamentos e protocolos nos órgãos competentes.' },
  { icon: ShieldCheck, title: 'Acompanhamento e conformidade', text: 'Acompanhamos exigências, condicionantes e prazos para a empresa seguir regular.' },
];

const faq = [
  {
    q: 'O que faz uma empresa de engenharia ambiental e segurança do trabalho?',
    a: 'Ajuda empresas a cumprir a legislação ambiental e as normas de segurança do trabalho: obtém licenças e outorgas, elabora planos e programas como PGRS e PGR, investiga áreas contaminadas, capacita equipes e acompanha prazos e exigências dos órgãos públicos.',
  },
  {
    q: 'A EARTH atende quais regiões?',
    a: `A EARTH Engenharia está em ${site.address.city}/${site.address.state} e atende: ${site.areaServed.join(', ')}. Para outras localidades, consulte disponibilidade.`,
  },
  {
    q: 'Preciso de empresas diferentes para meio ambiente e segurança do trabalho?',
    a: 'Não. A EARTH reúne consultoria ambiental e consultoria em segurança do trabalho em um só parceiro, o que mantém as informações coerentes entre licenças, planos, programas e treinamentos.',
  },
  {
    q: 'Como funciona a regularização ambiental de uma empresa?',
    a: 'Começa com um diagnóstico da atividade para identificar quais licenças, outorgas, planos e autorizações são exigidos. Em seguida elaboramos os documentos, protocolamos nos órgãos competentes e acompanhamos o processo até a regularização.',
  },
  {
    q: 'Como solicito um orçamento?',
    a: 'Pelo formulário da página de contato ou pelo WhatsApp. Fazemos algumas perguntas sobre a sua atividade e, se necessário, uma visita técnica. Depois enviamos uma proposta com escopo, prazo e investimento.',
  },
  {
    q: 'Vocês emitem ART nos serviços técnicos?',
    a: 'Os serviços de engenharia que exigem responsabilidade técnica são acompanhados da ART (Anotação de Responsabilidade Técnica) do profissional habilitado responsável.',
  },
  {
    q: 'A EARTH atende pequenas empresas?',
    a: 'Sim. Atendemos empresas de diferentes portes e segmentos — da pequena empresa que precisa do PGR à indústria que precisa de licenciamento ambiental e gerenciamento de resíduos.',
  },
];
---

<BaseLayout
  title="Engenharia Ambiental e Segurança do Trabalho em SP | EARTH"
  description="Engenharia ambiental e segurança do trabalho em São Paulo: licenciamento, outorga de água, PGRS, PGR, áreas contaminadas e cursos NR. Peça seu orçamento."
  schema={[faqPage(faq)]}
  preloadImage={preloadImage}
>
  <!-- 1. HERO -->
  <section class="relative overflow-hidden border-b border-line" aria-labelledby="hero-title">
    <div class="bg-grid-light pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="container-x relative grid items-center gap-10 pt-10 pb-14 sm:pt-14 lg:grid-cols-12 lg:gap-12 lg:pt-20 lg:pb-24">
      <div class="lg:col-span-6">
        <p class="label">Consultoria ambiental · {site.address.city}/{site.address.state}</p>
        <h1 id="hero-title" class="h-display mt-5">Engenharia Ambiental e Segurança do Trabalho em São Paulo</h1>
        <p class="lead mt-6 max-w-xl">{site.slogans.main}. {site.slogans.partner}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/contato/#orcamento" class="btn btn-primary">Solicitar orçamento <ArrowRight size={17} aria-hidden="true" /></a>
          <a href={whatsappUrl()} target="_blank" rel="noopener" class="btn btn-secondary" data-track="whatsapp-hero">
            <BrandIcon name="whatsapp" class="size-[18px] text-[#1da851]" /> Falar no WhatsApp
          </a>
        </div>
      </div>
      <div class="relative lg:col-span-6">
        <div class="relative overflow-hidden rounded-xl border border-line">
          <Picture
            src={heroImg}
            formats={['avif', 'webp']}
            widths={heroWidths}
            sizes={heroSizes}
            alt="Profissional da EARTH Engenharia em vistoria de campo para licenciamento ambiental em São Paulo"
            loading="eager"
            fetchpriority="high"
            class="aspect-[4/3] w-full object-cover"
          />
        </div>
        <div class="panel absolute right-3 -bottom-5 left-3 flex flex-wrap items-center gap-x-4 gap-y-1 px-4 py-3 shadow-[0_16px_32px_-20px_rgb(10_26_18/0.4)] sm:right-auto sm:left-6">
          <span class="font-mono text-[10px] tracking-[0.14em] text-muted uppercase">Áreas</span>
          <span class="text-sm font-medium">Meio Ambiente</span>
          <span class="text-sm font-medium">Segurança do Trabalho</span>
          <span class="text-sm font-medium">Treinamentos</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. PILARES -->
  <section aria-label="Pilares da EARTH Engenharia" class="border-b border-line">
    <ul class="container-x grid grid-cols-2 lg:grid-cols-4">
      {
        pillars.map((p, i) => {
          const Ico = pillarIcons[i];
          return (
            <li class:list={['py-7 pr-3 sm:py-9', i % 2 === 1 && 'border-l border-line pl-4 sm:pl-6', i >= 2 && 'border-t border-line lg:border-t-0', i === 2 && 'lg:border-l lg:pl-6']}>
              <Ico size={22} class="text-brand-500" aria-hidden="true" />
              <p class="mt-3 font-semibold tracking-tight">{p}</p>
              <p class="mt-1 text-sm leading-relaxed text-muted">{pillarTexts[i]}</p>
            </li>
          );
        })
      }
    </ul>
  </section>

  <!-- 3. SERVIÇOS -->
  <section id="servicos" class="section" aria-labelledby="servicos-title">
    <div class="container-x">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl">
          <p class="label">Serviços</p>
          <h2 id="servicos-title" class="h-section mt-4">Consultoria ambiental e em segurança do trabalho para empresas</h2>
          <p class="lead mt-4">Da regularização ambiental à capacitação da equipe: escolha o serviço e veja como funciona.</p>
        </div>
        <a href="/servicos/" class="btn btn-secondary self-start lg:self-auto">Ver todos os serviços <ArrowUpRight size={17} aria-hidden="true" /></a>
      </div>
      <ul class="mt-10 grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
        {services.map((s, i) => <ServiceGridCard service={s} index={i} />)}
      </ul>
    </div>
  </section>

  <!-- 4. COMO TRABALHAMOS -->
  <section class="section bg-mist" aria-labelledby="proc-title">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="label">Como trabalhamos</p>
        <h2 id="proc-title" class="h-section mt-4">Do diagnóstico à conformidade, em 4 etapas</h2>
      </div>
      <ol class="mt-12 grid border-t border-line sm:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((s, i) => (
            <li class:list={['border-b border-line py-8 sm:pr-6', i % 2 === 1 && 'sm:border-l sm:pl-6', i >= 1 && 'lg:border-l lg:pl-6']} data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <span class="flex items-center justify-between">
                <span class="font-mono text-xs text-brand-600">Etapa 0{i + 1}</span>
                <s.icon size={20} class="text-brand-500" aria-hidden="true" />
              </span>
              <h3 class="mt-4 text-xl">{s.title}</h3>
              <p class="mt-2 text-muted">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 5. SOBRE RESUMIDO -->
  <section class="section" aria-labelledby="sobre-title">
    <div class="container-x grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="label">Sobre a EARTH</p>
        <h2 id="sobre-title" class="h-section mt-4">{site.slogans.signature}</h2>
        <a href="/sobre/" class="btn btn-secondary mt-8">Conheça a empresa <ArrowUpRight size={17} aria-hidden="true" /></a>
      </div>
      <div class="grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:col-span-8">
        <div class="bg-white p-6 sm:p-8">
          <h3 class="font-mono text-xs font-medium tracking-[0.14em] text-brand-600 uppercase">Missão</h3>
          <p class="mt-4 text-lg leading-relaxed">{site.institutional.mission}</p>
        </div>
        <div class="bg-white p-6 sm:p-8">
          <h3 class="font-mono text-xs font-medium tracking-[0.14em] text-brand-600 uppercase">Visão</h3>
          <p class="mt-4 text-lg leading-relaxed">{site.institutional.vision}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. DIFERENCIAIS / NÚMEROS (placeholders editáveis em src/config/site.ts) -->
  <section class="border-y border-line bg-mist" aria-labelledby="dif-title">
    <div class="container-x section">
      <div class="max-w-2xl">
        <p class="label">Diferenciais</p>
        <h2 id="dif-title" class="h-section mt-4">Por que escolher a EARTH</h2>
      </div>
      <dl class="mt-10 grid grid-cols-2 border-t border-line lg:grid-cols-4">
        {
          site.stats.map((s, i) => (
            <div class:list={['border-b border-line py-6 pr-3', i % 2 === 1 && 'border-l pl-4 sm:pl-6', i === 2 && 'lg:border-l lg:pl-6']}>
              <dt class="sr-only">{s.label}</dt>
              <dd>
                <span class="block text-4xl font-semibold tracking-tight">{s.value}</span>
                <span class="mt-1 block text-sm text-muted">{s.label}</span>
              </dd>
            </div>
          ))
        }
      </dl>
      <ul class="mt-8 grid gap-4 md:grid-cols-3">
        {
          site.differentials.map((d) => (
            <li class="panel p-6">
              <h3 class="text-lg">{d.title}</h3>
              <p class="mt-2 text-muted">{d.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 7. FAQ -->
  <section class="section" aria-labelledby="faq-title">
    <div class="container-x grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="label">FAQ</p>
        <h2 id="faq-title" class="h-section mt-4">Perguntas frequentes</h2>
        <p class="mt-4 text-muted">
          Não encontrou sua resposta? <a href="/contato/" class="font-medium text-brand-600 underline decoration-leaf-400 underline-offset-4">Fale com a gente</a>.
        </p>
      </div>
      <div class="lg:col-span-8">
        <Faq items={faq} />
      </div>
    </div>
  </section>

  <!-- 8. CTA FINAL + CONTATO -->
  <CtaBanner />
  <section class="border-b border-line" aria-label="Contato rápido">
    <div class="container-x flex flex-col gap-4 py-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-medium">{site.name} · {site.address.city}/{site.address.state}</p>
      <div class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-sm">
        <a href={`tel:${site.contact.phoneHref}`} class="inline-flex items-center gap-2 hover:text-brand-600"><Phone size={15} aria-hidden="true" />{site.contact.phoneDisplay}</a>
        <a href="/contato/" class="inline-flex items-center gap-2 hover:text-brand-600">Formulário de contato <ArrowRight size={15} aria-hidden="true" /></a>
      </div>
    </div>
  </section>
</BaseLayout>
