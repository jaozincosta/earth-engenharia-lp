---
import { Picture } from 'astro:assets';
import { ArrowRight, ArrowUpRight, Factory, Construction, Store, Tractor, Stethoscope, Building } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BrandIcon from '@/components/BrandIcon.astro';
import ComplianceDashboard from '@/components/ComplianceDashboard.astro';
import SolutionTabs from '@/components/SolutionTabs.astro';
import ServiceFilter from '@/components/ServiceFilter.astro';
import Faq from '@/components/Faq.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import { site, whatsappUrl } from '@/config/site';
import { getServices } from '@/lib/services';
import campoImg from '@/assets/fotos/equipe-campo.jpg';
import segurancaImg from '@/assets/fotos/seguranca.jpg';

const services = await getServices();

const frameworks = ['CETESB', 'CONAMA', 'SP Águas', 'PNRS', 'NR-01', 'NR-15', 'NR-16', 'NR-35', 'eSocial SST', 'Bombeiros SP'];

const facts = [
  { value: String(services.length), label: 'serviços técnicos', note: 'ambientais e de SST' },
  { value: '3', label: 'áreas integradas', note: 'meio ambiente, segurança, conformidade' },
  { value: '1', label: 'parceiro', note: 'para toda a sua conformidade' },
  { value: 'ART', label: 'em cada laudo', note: 'responsável técnico habilitado' },
];

const steps = [
  { title: 'Diagnóstico', text: 'Mapeamos sua atividade, documentos existentes e pendências legais.' },
  { title: 'Proposta', text: 'Escopo, prazos e investimento claros — sem surpresas.' },
  { title: 'Execução', text: 'Levantamentos em campo, elaboração e protocolo dos documentos.' },
  { title: 'Monitoramento', text: 'Condicionantes, renovações e vencimentos sob controle contínuo.' },
];

const segments = [
  { icon: Factory, label: 'Indústrias' },
  { icon: Construction, label: 'Construção civil' },
  { icon: Store, label: 'Comércio e serviços' },
  { icon: Tractor, label: 'Agronegócio' },
  { icon: Stethoscope, label: 'Saúde' },
  { icon: Building, label: 'Condomínios' },
];

const faq = [
  {
    q: 'Quais regiões a EARTH Engenharia atende?',
    a: `Atendemos ${site.address.city} capital e a Grande São Paulo — ${site.areaServed.slice(1, -1).join(', ')} e região — com visitas técnicas presenciais. Para outras localidades, consulte disponibilidade.`,
  },
  {
    q: 'Preciso de empresas diferentes para meio ambiente e segurança do trabalho?',
    a: 'Não. A EARTH integra as duas áreas: licenças, PGRS, PGR, LTCAT, treinamentos, AVCB e eSocial ficam com um único parceiro, com informações consistentes entre si.',
  },
  {
    q: 'Como funciona o orçamento?',
    a: 'Você nos chama no WhatsApp ou pelo formulário, fazemos algumas perguntas sobre a atividade e, se necessário, uma visita técnica. Em seguida enviamos uma proposta com escopo, prazo e investimento.',
  },
  {
    q: 'Vocês emitem ART?',
    a: 'Sim. Os serviços técnicos que exigem responsabilidade técnica são acompanhados da Anotação de Responsabilidade Técnica (ART) do profissional habilitado.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout
  title="Engenharia Ambiental e Segurança do Trabalho em São Paulo"
  description={`${site.name}: licenciamento CETESB, PGRS, PGR, LTCAT, laudos, treinamentos de NRs, AVCB e eSocial em São Paulo/SP e Grande SP. Solicite um orçamento.`}
  schema={[faqSchema]}
>
  <!-- HERO -->
  <section class="relative overflow-hidden border-b border-line">
    <div class="bg-grid-light pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="container-x relative grid items-center gap-12 pt-10 pb-14 sm:pt-16 lg:grid-cols-12 lg:gap-10 lg:pt-20 lg:pb-24">
      <div class="lg:col-span-6">
        <p class="label">Engenharia · São Paulo/SP</p>
        <h1 class="h-display mt-5">
          Engenharia ambiental e segurança do trabalho, <span class="text-brand-600">sem pendências.</span>
        </h1>
        <p class="lead mt-6 max-w-xl">
          Licenças, resíduos, laudos, programas de SST e AVCB conduzidos por engenheiros — com controle de prazos para sua empresa operar em conformidade.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={whatsappUrl()} target="_blank" rel="noopener" class="btn btn-primary" data-track="whatsapp-hero">
            <BrandIcon name="whatsapp" class="size-[18px]" /> Solicitar orçamento
          </a>
          <a href="#servicos" class="btn btn-secondary">Ver serviços <ArrowRight size={17} aria-hidden="true" /></a>
        </div>
        <p class="mt-8 font-mono text-xs text-muted">{site.slogans.partner}</p>
      </div>
      <div class="lg:col-span-6" data-reveal>
        <ComplianceDashboard />
      </div>
    </div>
  </section>

  <!-- NORMAS / ÓRGÃOS -->
  <section aria-label="Normas e órgãos com que trabalhamos" class="border-b border-line">
    <div class="container-x flex flex-col gap-4 py-6 lg:flex-row lg:items-center lg:gap-10">
      <p class="shrink-0 font-mono text-[11px] tracking-[0.14em] text-muted uppercase">Atuamos conforme</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-[15px] font-semibold tracking-tight text-ink/45">
        {frameworks.map((f) => <li>{f}</li>)}
      </ul>
    </div>
  </section>

  <!-- NÚMEROS -->
  <section class="border-b border-line">
    <div class="container-x">
      <dl class="grid grid-cols-2 lg:grid-cols-4">
        {
          facts.map((f, i) => (
            <div
              class:list={[
                'py-8 pr-4 sm:py-10',
                i % 2 === 1 && 'border-l border-line pl-4 sm:pl-6',
                i >= 2 && 'border-t border-line lg:border-t-0',
                i === 2 && 'lg:border-l lg:pl-6',
              ]}
              data-reveal
              style={`--reveal-delay:${i * 70}ms`}
            >
              <dt class="sr-only">{f.label}</dt>
              <dd>
                <span class="block text-4xl font-semibold tracking-tight sm:text-5xl">{f.value}</span>
                <span class="mt-2 block font-medium">{f.label}</span>
                <span class="block text-sm text-muted">{f.note}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- SOLUÇÕES (abas) -->
  <section class="relative overflow-hidden bg-brand-950 text-white" aria-labelledby="solucoes-title">
    <div class="bg-grid-dark pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="container-x section relative">
      <div class="max-w-2xl" data-reveal>
        <p class="font-mono text-[11px] tracking-[0.14em] text-leaf-300 uppercase">01 — Soluções</p>
        <h2 id="solucoes-title" class="h-section mt-4 text-white">Meio ambiente, segurança e conformidade em um só parceiro.</h2>
      </div>
      <div class="mt-12">
        <SolutionTabs />
      </div>
    </div>
  </section>

  <!-- SERVIÇOS -->
  <section id="servicos" class="section" aria-labelledby="servicos-title">
    <div class="container-x">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between" data-reveal>
        <div class="max-w-2xl">
          <p class="label">02 — Serviços</p>
          <h2 id="servicos-title" class="h-section mt-4">Encontre o serviço que sua empresa precisa.</h2>
        </div>
        <p class="max-w-sm text-muted">Filtre por área ou busque pelo nome do documento — LO, PGR, LTCAT, AVCB…</p>
      </div>
      <div class="mt-10">
        <ServiceFilter services={services} />
      </div>
    </div>
  </section>

  <!-- EM CAMPO -->
  <section class="section bg-mist" aria-labelledby="campo-title">
    <div class="container-x grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5" data-reveal>
        <p class="label">03 — Em campo</p>
        <h2 id="campo-title" class="h-section mt-4">Documentos que funcionam na prática.</h2>
        <p class="lead mt-5">
          Antes de qualquer laudo ou estudo, vamos até a sua operação. Medições, vistorias e levantamentos feitos por quem assina a responsabilidade técnica.
        </p>
        <a href="/sobre/" class="btn btn-secondary mt-8">Conheça a EARTH <ArrowUpRight size={17} aria-hidden="true" /></a>
      </div>
      <div class="grid grid-cols-5 gap-3 lg:col-span-7" data-reveal>
        <Picture
          src={campoImg}
          formats={['avif', 'webp']}
          widths={[400, 700, 1000]}
          sizes="(min-width: 1024px) 34vw, 56vw"
          alt="Equipe da EARTH Engenharia realizando vistoria técnica em campo"
          class="col-span-3 aspect-[4/5] w-full rounded-xl object-cover"
        />
        <div class="col-span-2 flex flex-col gap-3">
          <Picture
            src={segurancaImg}
            formats={['avif', 'webp']}
            widths={[300, 500]}
            sizes="(min-width: 1024px) 22vw, 36vw"
            alt="Inspeção de segurança do trabalho"
            class="aspect-square w-full rounded-xl object-cover"
          />
          <div class="panel flex flex-1 flex-col justify-end p-4">
            <p class="font-mono text-[10px] tracking-[0.14em] text-muted uppercase">Medições</p>
            <p class="mt-1 text-sm font-medium">Ruído, calor, agentes químicos e efluentes com equipamentos calibrados.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESSO -->
  <section class="section" aria-labelledby="proc-title">
    <div class="container-x">
      <div class="max-w-2xl" data-reveal>
        <p class="label">04 — Processo</p>
        <h2 id="proc-title" class="h-section mt-4">Do primeiro contato à conformidade contínua.</h2>
      </div>
      <ol class="mt-12 grid border-t border-line sm:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((s, i) => (
            <li
              class:list={['relative border-b border-line py-8 sm:pr-6', i % 2 === 1 && 'sm:border-l sm:pl-6', i >= 1 && 'lg:border-l lg:pl-6']}
              data-reveal
              style={`--reveal-delay:${i * 80}ms`}
            >
              <span class="absolute -top-[5px] left-0 size-2.5 rounded-full border-2 border-white bg-leaf-400 sm:left-auto" aria-hidden="true" />
              <span class="font-mono text-xs text-brand-600">Etapa 0{i + 1}</span>
              <h3 class="mt-3 text-xl">{s.title}</h3>
              <p class="mt-2 text-muted">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- SEGMENTOS -->
  <section class="border-y border-line bg-mist" aria-labelledby="seg-title">
    <div class="container-x grid gap-6 py-12 lg:grid-cols-12 lg:items-center">
      <h2 id="seg-title" class="text-2xl lg:col-span-3">Segmentos atendidos</h2>
      <ul class="grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-3 lg:col-span-9 lg:grid-cols-6">
        {
          segments.map((s) => (
            <li class="flex flex-col items-start gap-3 bg-white p-4 text-sm font-medium">
              <s.icon size={22} class="text-brand-500" aria-hidden="true" />
              {s.label}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" aria-labelledby="faq-title">
    <div class="container-x grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4" data-reveal>
        <p class="label">05 — FAQ</p>
        <h2 id="faq-title" class="h-section mt-4">Perguntas frequentes</h2>
        <p class="mt-4 text-muted">
          Não encontrou sua resposta? <a href="/contato/" class="font-medium text-brand-600 underline decoration-leaf-400 underline-offset-4">Fale com a gente</a>.
        </p>
      </div>
      <div class="lg:col-span-8" data-reveal>
        <Faq items={faq} />
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
