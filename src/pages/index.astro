---
import { Picture, getImage } from 'astro:assets';
import { ArrowRight, ArrowUpRight, Leaf, Scale, HeartHandshake, SlidersHorizontal, Search, ClipboardList, Wrench, ShieldCheck, Phone } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BrandIcon from '@/components/BrandIcon.astro';
import Icon from '@/components/Icon.astro';
import ServiceGridCard from '@/components/ServiceGridCard.astro';
import Faq from '@/components/Faq.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import ProjectsGrid from '@/components/ProjectsGrid.astro';
import ClientsStrip from '@/components/ClientsStrip.astro';
import { pillars, site, whatsappUrl } from '@/config/site';
import { heroVideo, sectionImages } from '@/config/media';
import { getServices, serviceUrl } from '@/lib/services';
import { faqPage } from '@/lib/schema';

const services = await getServices();
const heroChips = ['licenciamento-ambiental', 'outorga-de-uso-de-agua', 'pgr-engenharia-seguranca-do-trabalho', 'cursos-nr-33-e-nr-35']
  .map((slug) => services.find((s) => s.id === slug))
  .filter((s) => s !== undefined);

// Poster do vídeo = elemento LCP: mesmos parâmetros no <Picture> e no preload.
const heroWidths = [480, 768, 1080, 1440, 1920];
const heroQuality = 50; // imagem fica sob overlay escuro: qualidade menor sem perda visível
const heroSizes = '100vw';
const heroAvif = await getImage({ src: heroVideo.poster.src, format: 'avif', widths: heroWidths, quality: heroQuality });
const preloadImage = { src: heroAvif.src, srcset: heroAvif.srcSet.attribute, sizes: heroSizes, type: 'image/avif' };

const pillarIcons = [Leaf, Scale, HeartHandshake, SlidersHorizontal];
const pillarTexts = [
  'Soluções técnicas que reduzem impactos e protegem os recursos naturais.',
  'Licenças, programas e documentos em dia com a legislação.',
  'Segurança e valorização da vida em cada atividade.',
  'Cada projeto desenhado para a realidade da sua empresa.',
];

const steps = [
  { icon: Search, title: 'Diagnóstico', text: 'Entendemos a sua atividade, visitamos o local e mapeamos as obrigações ambientais e de segurança do trabalho.' },
  { icon: ClipboardList, title: 'Planejamento', text: 'Definimos escopo, etapas, prazos e responsáveis em uma proposta clara.' },
  { icon: Wrench, title: 'Execução', text: 'Levantamentos em campo, elaboração dos documentos, treinamentos e protocolos nos órgãos competentes.' },
  { icon: ShieldCheck, title: 'Acompanhamento e conformidade', text: 'Acompanhamos exigências, condicionantes e prazos para a empresa seguir regular.' },
];

const faq = [
  {
    q: 'O que faz uma empresa de engenharia ambiental e segurança do trabalho?',
    a: 'Ajuda empresas a cumprir a legislação ambiental e as normas de segurança do trabalho: obtém licenças e outorgas, elabora planos e programas como PGRS e PGR, investiga áreas contaminadas, capacita equipes e acompanha prazos e exigências dos órgãos públicos.',
  },
  {
    q: 'A EARTH atende quais regiões?',
    a: `A EARTH Engenharia está em ${site.address.city}/${site.address.state} e atende: ${site.areaServed.join(', ')}. Para outras localidades, consulte disponibilidade.`,
  },
  {
    q: 'Preciso de empresas diferentes para meio ambiente e segurança do trabalho?',
    a: 'Não. A EARTH reúne consultoria ambiental e consultoria em segurança do trabalho em um só parceiro, o que mantém as informações coerentes entre licenças, planos, programas e treinamentos.',
  },
  {
    q: 'Como funciona a regularização ambiental de uma empresa?',
    a: 'Começa com um diagnóstico da atividade para identificar quais licenças, outorgas, planos e autorizações são exigidos. Em seguida elaboramos os documentos, protocolamos nos órgãos competentes e acompanhamos o processo até a regularização.',
  },
  {
    q: 'Como solicito um orçamento?',
    a: 'Pelo formulário da página de contato ou pelo WhatsApp. Fazemos algumas perguntas sobre a sua atividade e, se necessário, uma visita técnica. Depois enviamos uma proposta com escopo, prazo e investimento.',
  },
  {
    q: 'Vocês emitem ART nos serviços técnicos?',
    a: 'Os serviços de engenharia que exigem responsabilidade técnica são acompanhados da ART (Anotação de Responsabilidade Técnica) do profissional habilitado responsável.',
  },
  {
    q: 'A EARTH atende pequenas empresas?',
    a: 'Sim. Atendemos empresas de diferentes portes e segmentos — da pequena empresa que precisa do PGR à indústria que precisa de licenciamento ambiental e gerenciamento de resíduos.',
  },
];
---

<BaseLayout
  title="Engenharia Ambiental e Segurança do Trabalho em SP | EARTH"
  description="Engenharia ambiental e segurança do trabalho em São Paulo: licenciamento, outorga de água, PGRS, PGR, áreas contaminadas e cursos NR. Peça seu orçamento."
  schema={[faqPage(faq)]}
  preloadImage={preloadImage}
>
  <!-- 1. HERO com vídeo -->
  <section class="relative isolate flex min-h-[90vh] flex-col justify-end overflow-hidden" aria-labelledby="hero-title">
    <Picture
      src={heroVideo.poster.src}
      formats={['avif', 'webp']}
      widths={heroWidths}
      sizes={heroSizes}
      quality={heroQuality}
      alt={heroVideo.poster.alt}
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-30 size-full object-cover"
    />
    <!-- Vídeo: inserido via JS após o carregamento (versão leve no celular), sem reduced-motion e sem economia de dados -->
    <div
      class="absolute inset-0 -z-20"
      data-hero-video
      data-webm={heroVideo.webm}
      data-mp4={heroVideo.mp4}
      data-webm-mobile={heroVideo.webmMobile}
      data-mp4-mobile={heroVideo.mp4Mobile}
      aria-hidden="true"
    ></div>
    <div class="overlay-hero absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="bg-grid pointer-events-none absolute inset-0 -z-10 opacity-60" aria-hidden="true"></div>

    <div class="container-x relative pt-24 pb-10 sm:pt-32 lg:pt-40">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <p class="label">Consultoria ambiental · {site.address.city}/{site.address.state}</p>
        <p class="tech hidden sm:block">23°33′S · 46°38′W</p>
      </div>
      <h1 id="hero-title" class="h-display mt-6 max-w-4xl">Engenharia Ambiental e Segurança do Trabalho</h1>
      <p class="lead mt-6 max-w-2xl text-ink/85">{site.slogans.main}. {site.slogans.partner}</p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href="/contato/#orcamento" class="btn btn-primary min-h-13 px-6">Solicitar orçamento <ArrowRight size={17} aria-hidden="true" /></a>
        <a href={whatsappUrl()} target="_blank" rel="noopener" class="btn btn-secondary min-h-13 px-6" data-track="whatsapp-hero">
          <BrandIcon name="whatsapp" class="size-[18px] text-[#25D366]" /> Falar no WhatsApp
        </a>
      </div>

      <!-- Faixa glass com serviços -->
      <nav class="glass mt-14 grid grid-cols-2 gap-px overflow-hidden p-0 lg:grid-cols-4" aria-label="Serviços em destaque">
        {
          heroChips.map((s) => (
            <a href={serviceUrl(s)} class="group flex items-center gap-3 px-4 py-4 transition-colors hover:bg-white/[0.06] sm:px-5">
              <Icon name={s.data.icon} size={20} class="shrink-0 text-leaf-400" />
              <span class="min-w-0 flex-1 text-sm leading-snug font-medium">{s.data.title}</span>
              <ArrowUpRight size={16} class="hidden shrink-0 text-ink/50 transition-colors group-hover:text-leaf-300 sm:block" aria-hidden="true" />
            </a>
          ))
        }
      </nav>
      <div class="mt-4 flex justify-between">
        <p class="tech">CETESB · SP Águas · NR 1 · NR 33 · NR 35</p>
        <p class="tech hidden items-center gap-2 sm:flex"><span class="pulse-dot size-1.5 rounded-full bg-leaf-400"></span>Monitoramento contínuo</p>
      </div>
    </div>
  </section>

  <!-- 2. PILARES -->
  <section aria-label="Pilares da EARTH Engenharia" class="border-y border-line bg-panel">
    <ul class="container-x grid grid-cols-2 lg:grid-cols-4">
      {
        pillars.map((p, i) => {
          const Ico = pillarIcons[i];
          return (
            <li class:list={['py-8 pr-3 sm:py-10', i % 2 === 1 && 'border-l border-line pl-4 sm:pl-6', i >= 2 && 'border-t border-line lg:border-t-0', i === 2 && 'lg:border-l lg:pl-6']} data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <Ico size={26} class="text-leaf-400 drop-shadow-[0_0_10px_rgb(122_201_67/0.7)]" aria-hidden="true" />
              <p class="mt-4 font-semibold tracking-tight">{p}</p>
              <p class="mt-1 text-sm leading-relaxed text-muted">{pillarTexts[i]}</p>
            </li>
          );
        })
      }
    </ul>
  </section>

  <!-- 3. SERVIÇOS -->
  <section id="servicos" class="section relative isolate" aria-labelledby="servicos-title">
    <div class="bg-topo pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="container-x">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl">
          <p class="label">Serviços</p>
          <h2 id="servicos-title" class="h-section mt-4">Consultoria ambiental e em segurança do trabalho para empresas</h2>
          <p class="lead mt-4">Da regularização ambiental à capacitação da equipe: escolha o serviço e veja como funciona.</p>
        </div>
        <a href="/servicos/" class="btn btn-secondary self-start lg:self-auto">Ver todos os serviços <ArrowUpRight size={17} aria-hidden="true" /></a>
      </div>
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {services.map((s, i) => <ServiceGridCard service={s} index={i} />)}
      </ul>
    </div>
  </section>

  <!-- 4. COMO TRABALHAMOS — linha do tempo que acende no scroll -->
  <section class="section relative border-y border-line bg-panel" aria-labelledby="proc-title" data-timeline>
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="label">Como trabalhamos</p>
        <h2 id="proc-title" class="h-section mt-4">Do diagnóstico à conformidade, em 4 etapas</h2>
      </div>
      <div class="relative mt-14">
        <!-- trilho + preenchimento (horizontal no desktop, vertical no mobile) -->
        <div class="absolute top-0 bottom-0 left-[19px] w-px bg-line lg:top-[19px] lg:right-0 lg:bottom-auto lg:left-0 lg:h-px lg:w-auto" aria-hidden="true">
          <div class="h-[calc(var(--progress,1)*100%)] w-full bg-leaf-400 shadow-[0_0_12px_rgb(122_201_67/0.9)] lg:h-full lg:w-[calc(var(--progress,1)*100%)]" data-timeline-fill></div>
        </div>
        <ol class="grid gap-10 lg:grid-cols-4 lg:gap-8">
          {
            steps.map((s, i) => (
              <li class="relative pl-14 lg:pt-14 lg:pl-0" data-step={i}>
                <span class="absolute top-0 left-0 grid size-10 place-items-center rounded-full border border-line bg-surface text-muted transition duration-500 data-[on=true]:border-leaf-400 data-[on=true]:text-leaf-400 data-[on=true]:shadow-[0_0_20px_rgb(122_201_67/0.6)]" data-step-dot>
                  <s.icon size={18} aria-hidden="true" />
                </span>
                <span class="tech text-accent">Etapa 0{i + 1}</span>
                <h3 class="mt-2 text-xl">{s.title}</h3>
                <p class="mt-2 text-muted">{s.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- 5. SOBRE RESUMIDO — foto grande + texto -->
  <section class="relative grid lg:grid-cols-2" aria-labelledby="sobre-title">
    <div class="relative min-h-[320px] overflow-hidden sm:min-h-[420px]">
      <Picture
        src={sectionImages.natureza.src}
        formats={['avif', 'webp']}
        widths={[640, 960, 1280]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        alt={sectionImages.natureza.alt}
        class="absolute inset-0 size-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-surface/80 via-transparent lg:bg-gradient-to-r lg:from-transparent lg:via-transparent lg:to-surface" aria-hidden="true"></div>
      <p class="tech absolute bottom-4 left-4 text-ink/80">Mata Atlântica · Bioma protegido</p>
    </div>
    <div class="container-x flex flex-col justify-center py-16 lg:mx-0 lg:max-w-none lg:px-16 lg:py-24">
      <p class="label">Sobre a EARTH</p>
      <h2 id="sobre-title" class="h-section mt-4">{site.slogans.signature}</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <div class="glass p-6">
          <h3 class="tech text-accent">Missão</h3>
          <p class="mt-3 leading-relaxed">{site.institutional.mission}</p>
        </div>
        <div class="glass p-6">
          <h3 class="tech text-accent">Visão</h3>
          <p class="mt-3 leading-relaxed">{site.institutional.vision}</p>
        </div>
      </div>
      <a href="/sobre/" class="btn btn-secondary mt-8 self-start">Conheça a empresa <ArrowUpRight size={17} aria-hidden="true" /></a>
    </div>
  </section>

  <!-- PROJETOS E EXPERIÊNCIA (fotos reais da EARTH) -->
  <section class="section relative isolate" aria-labelledby="projetos-title">
    <div class="bg-topo pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="container-x">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl">
          <p class="label">Projetos</p>
          <h2 id="projetos-title" class="h-section mt-4">Experiência em campo, do rio à cidade</h2>
          <p class="lead mt-4">Alguns dos trabalhos conduzidos pela equipe da EARTH em licenciamento, recursos hídricos, áreas contaminadas e projetos urbanos.</p>
        </div>
        <a href="/sobre/" class="btn btn-secondary self-start lg:self-auto">Conheça a equipe <ArrowUpRight size={17} aria-hidden="true" /></a>
      </div>
      <div class="mt-12">
        <ProjectsGrid />
      </div>
    </div>
  </section>

  <!-- 6. DIFERENCIAIS / NÚMEROS sobre foto aérea (editáveis em src/config/site.ts) -->
  <section class="relative isolate overflow-hidden border-y border-line" aria-labelledby="dif-title">
    <Picture
      src={sectionImages.aerea.src}
      formats={['avif', 'webp']}
      widths={[640, 1280, 1920]}
      sizes="100vw"
      alt={sectionImages.aerea.alt}
      class="absolute inset-0 -z-20 size-full object-cover"
    />
    <div class="overlay-full absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="container-x section">
      <div class="max-w-2xl">
        <p class="label">Diferenciais</p>
        <h2 id="dif-title" class="h-section mt-4">Por que escolher a EARTH</h2>
      </div>
      <dl class="mt-12 grid grid-cols-2 gap-4 lg:grid-cols-4">
        {
          site.stats.map((s) => (
            <div class="glass p-5 sm:p-6">
              <dt class="sr-only">{s.label}</dt>
              <dd>
                <span class="block text-4xl font-semibold tracking-tight text-leaf-400 drop-shadow-[0_0_18px_rgb(122_201_67/0.45)] sm:text-5xl" data-count={'animate' in s && s.animate === false ? undefined : s.value}>{s.value}</span>
                <span class="mt-2 block text-sm text-ink/80">{s.label}</span>
              </dd>
            </div>
          ))
        }
      </dl>
      <ul class="mt-4 grid gap-4 md:grid-cols-3">
        {
          site.differentials.map((d) => (
            <li class="glass p-6">
              <h3 class="text-lg">{d.title}</h3>
              <p class="mt-2 text-ink/75">{d.text}</p>
            </li>
          ))
        }
      </ul>
      <div class="mt-4">
        <ClientsStrip />
      </div>
    </div>
  </section>

  <!-- 7. FAQ (seção clara pontual) -->
  <section class="theme-light section" aria-labelledby="faq-title">
    <div class="container-x grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="label">FAQ</p>
        <h2 id="faq-title" class="h-section mt-4">Perguntas frequentes</h2>
        <p class="mt-4 text-muted">
          Não encontrou sua resposta? <a href="/contato/" class="font-medium text-accent underline decoration-leaf-500 underline-offset-4">Fale com a gente</a>.
        </p>
      </div>
      <div class="lg:col-span-8">
        <Faq items={faq} />
      </div>
    </div>
  </section>

  <!-- 8. CTA FINAL + CONTATO -->
  <CtaBanner />
  <section class="bg-panel" aria-label="Contato rápido">
    <div class="container-x flex flex-col gap-4 py-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-medium">{site.name} · {site.address.city}/{site.address.state}</p>
      <div class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-sm">
        <a href={`tel:${site.contact.phoneHref}`} class="inline-flex items-center gap-2 hover:text-leaf-300"><Phone size={15} aria-hidden="true" />{site.contact.phoneDisplay}</a>
        <a href="/contato/" class="inline-flex items-center gap-2 hover:text-leaf-300">Formulário de contato <ArrowRight size={15} aria-hidden="true" /></a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // ── Vídeo do hero: só depois do load, sem reduced-motion e sem economia de dados.
  //    No celular (< 768px) usa a versão leve de 540p. ──
  const slot = document.querySelector<HTMLElement>('[data-hero-video]');
  const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  const mobile = matchMedia('(max-width: 767px)').matches;
  const canPlay = slot && !matchMedia('(prefers-reduced-motion: reduce)').matches && !conn?.saveData;
  const startVideo = () => {
    if (!slot) return;
    const v = document.createElement('video');
    // iOS/Android só fazem autoplay de vídeo mudo e inline: define propriedades E atributos antes das fontes.
    v.muted = true;
    v.defaultMuted = true;
    v.loop = true;
    v.playsInline = true;
    v.autoplay = true;
    v.preload = 'auto';
    for (const a of ['muted', 'playsinline', 'webkit-playsinline', 'autoplay', 'loop']) v.setAttribute(a, '');
    v.disablePictureInPicture = true;
    v.className = 'size-full object-cover opacity-0 transition-opacity duration-1000';
    const webm = mobile ? slot.dataset.webmMobile! : slot.dataset.webm!;
    const mp4 = mobile ? slot.dataset.mp4Mobile! : slot.dataset.mp4!;
    for (const [src, type] of [[webm, 'video/webm'], [mp4, 'video/mp4']]) {
      const s = document.createElement('source');
      s.src = src;
      s.type = type;
      v.appendChild(s);
    }
    v.addEventListener('playing', () => v.classList.remove('opacity-0'), { once: true });
    slot.appendChild(v);
    v.play().catch(() => {});
  };
  if (canPlay) {
    const later = () => ('requestIdleCallback' in window ? requestIdleCallback(startVideo, { timeout: 2500 }) : setTimeout(startVideo, 1200));
    document.readyState === 'complete' ? later() : addEventListener('load', later, { once: true });
  }

  // ── Linha do tempo que acende conforme a rolagem ──
  const tl = document.querySelector<HTMLElement>('[data-timeline]');
  const fill = tl?.querySelector<HTMLElement>('[data-timeline-fill]');
  const dots = tl ? [...tl.querySelectorAll<HTMLElement>('[data-step-dot]')] : [];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (tl && fill) {
    const update = () => {
      const r = tl.getBoundingClientRect();
      const p = reduce ? 1 : Math.min(1, Math.max(0, (innerHeight * 0.75 - r.top) / (r.height * 0.6)));
      tl.style.setProperty('--progress', p.toFixed(3));
      dots.forEach((d, i) => (d.dataset.on = String(p >= i / dots.length + 0.05 || p === 1)));
    };
    update();
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update, { passive: true });
  }

  // ── Contadores (só animam valores numéricos; placeholders como "[00]" ficam como estão) ──
  const counters = document.querySelectorAll<HTMLElement>('[data-count]');
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      io.unobserve(e.target);
      const el = e.target as HTMLElement;
      const m = (el.dataset.count ?? '').match(/^(\D*)(\d+(?:[.,]\d+)?)(.*)$/);
      if (!m || reduce) continue;
      const target = parseFloat(m[2].replace(',', '.'));
      const t0 = performance.now();
      const tick = (t: number) => {
        const k = Math.min(1, (t - t0) / 1400);
        const val = target * (1 - Math.pow(1 - k, 3));
        el.textContent = `${m[1]}${Number.isInteger(target) ? Math.round(val) : val.toFixed(1)}${m[3]}`;
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  });
  counters.forEach((c) => io.observe(c));
</script>
