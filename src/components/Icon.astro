---
/**
 * Renderiza um ícone Lucide pelo nome (usado pelos ícones definidos no frontmatter dos serviços).
 * Gera SVG estático em build — zero JavaScript no cliente.
 */
import { icons } from '@lucide/astro';

interface Props {
  name: string;
  size?: number;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 24, class: className, strokeWidth = 1.75 } = Astro.props;
const Cmp = (icons as Record<string, any>)[name] ?? icons.Leaf;
---

<Cmp size={size} class={className} stroke-width={strokeWidth} aria-hidden="true" />
