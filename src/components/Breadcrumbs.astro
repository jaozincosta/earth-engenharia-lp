---
import { ChevronRight } from '@lucide/astro';

interface Props {
  items: { label: string; href: string }[];
  dark?: boolean;
}
const { items, dark = true } = Astro.props;
const all = [{ label: 'Início', href: '/' }, ...items];
---

<nav aria-label="Você está em" class="text-sm">
  <ol class:list={['flex flex-wrap items-center gap-1', dark ? 'text-white/70' : 'text-muted']}>
    {
      all.map((item, i) => (
        <li class="flex items-center gap-1">
          {i > 0 && <ChevronRight size={14} aria-hidden="true" class="opacity-60" />}
          {i === all.length - 1 ? (
            <span aria-current="page" class={dark ? 'text-white' : 'text-brand-800'}>
              {item.label}
            </span>
          ) : (
            <a href={item.href} class="hover:underline">
              {item.label}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
