---
/**
 * Botão "voltar ao topo" — fica acima do botão de WhatsApp, em todas as páginas.
 * Aparece depois de rolar ~1 tela; respeita prefers-reduced-motion (sem rolagem suave).
 */
import { ArrowUp } from '@lucide/astro';
---

<button
  type="button"
  id="back-to-top"
  aria-label="Voltar ao topo da página"
  title="Voltar ao topo"
  class="fixed right-[1.375rem] bottom-[calc(max(1rem,env(safe-area-inset-bottom))+4.25rem)] z-40 grid size-11 translate-y-3 place-items-center rounded-full border border-line bg-surface/80 text-leaf-400 opacity-0 shadow-[0_8px_24px_-8px_rgb(0_0_0/0.6)] backdrop-blur-md transition duration-300 pointer-events-none hover:border-leaf-400/70 hover:text-leaf-300 hover:shadow-[0_0_0_1px_rgb(122_201_67/0.3),0_10px_30px_-8px_rgb(122_201_67/0.5)] data-[show=true]:pointer-events-auto data-[show=true]:translate-y-0 data-[show=true]:opacity-100 motion-reduce:transition-none sm:right-[1.875rem] sm:bottom-[5.5rem]"
  tabindex="-1"
>
  <ArrowUp size={20} aria-hidden="true" />
</button>

<script>
  const btn = document.getElementById('back-to-top')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const update = () => {
    const show = window.scrollY > window.innerHeight * 0.8;
    btn.dataset.show = String(show);
    btn.tabIndex = show ? 0 : -1;
    btn.setAttribute('aria-hidden', String(!show));
  };
  btn.addEventListener('click', (e) => {
    window.scrollTo({ top: 0, behavior: reduce.matches ? 'auto' : 'smooth' });
    // Acionado pelo teclado (detail === 0): leva o foco ao início da página. Com mouse/toque, só rola.
    if (e.detail === 0) document.querySelector<HTMLElement>('#site-header a')?.focus({ preventScroll: true });
    else btn.blur();
  });
  update();
  addEventListener('scroll', update, { passive: true });
  addEventListener('resize', update, { passive: true });
</script>
