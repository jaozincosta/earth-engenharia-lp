---
/**
 * Accordion de FAQ com <details>/<summary> nativos — acessível e sem JavaScript.
 * Um pequeno script opcional fecha os outros itens ao abrir um (comportamento de accordion).
 */
import { Plus } from '@lucide/astro';

interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="faq divide-y divide-brand-100 overflow-hidden rounded-3xl border border-brand-100 bg-white" data-accordion>
  {
    items.map((item) => (
      <details class="group">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 p-5 text-left font-semibold text-brand-900 transition hover:bg-brand-50/60 sm:p-6 [&::-webkit-details-marker]:hidden">
          <span>{item.q}</span>
          <span class="grid size-7 shrink-0 place-items-center rounded-full bg-brand-50 text-brand-600 transition group-open:rotate-45 group-open:bg-leaf-400 group-open:text-brand-950">
            <Plus size={16} aria-hidden="true" />
          </span>
        </summary>
        <p class="px-5 pb-6 leading-relaxed text-muted sm:px-6">{item.a}</p>
      </details>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-accordion]').forEach((root) => {
    const items = root.querySelectorAll('details');
    items.forEach((d) =>
      d.addEventListener('toggle', () => {
        if (d.open) items.forEach((o) => o !== d && (o.open = false));
      }),
    );
  });
</script>
