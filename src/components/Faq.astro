---
/**
 * Accordion de FAQ com <details>/<summary> nativos — acessível e sem JavaScript obrigatório.
 * O script apenas fecha os outros itens ao abrir um.
 */
import { Plus } from '@lucide/astro';

interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="border-t border-line" data-accordion>
  {
    items.map((item) => (
      <details class="group border-b border-line">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 text-left text-[17px] font-medium tracking-tight text-ink transition-colors hover:text-leaf-300 [&::-webkit-details-marker]:hidden">
          <span>{item.q}</span>
          <Plus size={20} class="mt-0.5 shrink-0 text-leaf-400 transition-transform group-open:rotate-45" aria-hidden="true" />
        </summary>
        <p class="max-w-3xl pb-6 leading-relaxed text-muted">{item.a}</p>
      </details>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-accordion]').forEach((root) => {
    const items = root.querySelectorAll('details');
    items.forEach((d) =>
      d.addEventListener('toggle', () => {
        if (d.open) items.forEach((o) => o !== d && (o.open = false));
      }),
    );
  });
</script>
