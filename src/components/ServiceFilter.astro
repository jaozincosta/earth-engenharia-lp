---
/**
 * Filtro de serviços (ilha mínima em JS puro): abas de área + busca por texto.
 * Sem JS, todos os serviços continuam visíveis e navegáveis.
 */
import { Search } from '@lucide/astro';
import ServiceCard from './ServiceCard.astro';
import { categories } from '@/config/site';
import type { Service } from '@/lib/services';

interface Props {
  services: Service[];
  withSearch?: boolean;
}
const { services, withSearch = true } = Astro.props;
const chips = [
  { key: 'all', label: 'Todos', count: services.length },
  ...Object.entries(categories).map(([key, c]) => ({ key, label: c.label, count: services.filter((s) => s.data.category === key).length })),
];
---

<div data-service-filter>
  <div class="flex flex-col gap-4 border-b border-line pb-4 md:flex-row md:items-center md:justify-between">
    <div class="-mx-4 flex gap-1 overflow-x-auto px-4 [scrollbar-width:none] sm:mx-0 sm:px-0" role="group" aria-label="Filtrar por área">
      {
        chips.map((c, i) => (
          <button
            type="button"
            data-filter={c.key}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="inline-flex shrink-0 items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium whitespace-nowrap text-muted transition-colors hover:bg-mist hover:text-ink aria-pressed:bg-ink aria-pressed:text-white"
          >
            {c.label}
            <span class="font-mono text-[11px] opacity-60">{c.count}</span>
          </button>
        ))
      }
    </div>
    {
      withSearch && (
        <label class="relative block md:w-80">
          <span class="sr-only">Buscar serviço</span>
          <Search size={17} class="pointer-events-none absolute top-1/2 left-3.5 -translate-y-1/2 text-muted" aria-hidden="true" />
          <input
            type="search"
            data-search-input
            placeholder="Buscar: PGR, LTCAT, AVCB, CETESB…"
            class="h-11 w-full rounded-lg border border-line bg-white pr-3 pl-10 text-base text-ink placeholder:text-muted/70 focus:border-brand-500 focus:outline-none"
          />
        </label>
      )
    }
  </div>

  <div data-service-grid>
    {services.map((s, i) => <ServiceCard service={s} index={i} />)}
  </div>
  <p data-empty class="mt-6 hidden rounded-xl border border-dashed border-line p-6 text-center text-muted">
    Nenhum serviço encontrado. <a href="/contato/" class="font-medium text-brand-600 underline">Fale com a gente</a> — provavelmente podemos ajudar.
  </p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-service-filter]').forEach((root) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const input = root.querySelector<HTMLInputElement>('[data-search-input]');
    const rows = root.querySelectorAll<HTMLElement>('[data-service]');
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    let cat = 'all';

    const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

    const apply = () => {
      const q = norm(input?.value.trim() ?? '');
      let visible = 0;
      rows.forEach((r) => {
        const show = (cat === 'all' || r.dataset.category === cat) && (!q || norm(r.dataset.search ?? '').includes(q));
        r.hidden = !show;
        if (show) visible++;
      });
      empty.classList.toggle('hidden', visible > 0);
    };

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        cat = b.dataset.filter!;
        buttons.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
        apply();
      }),
    );
    input?.addEventListener('input', apply);

    // Permite links como /servicos/?area=meio-ambiente
    const area = new URLSearchParams(location.search).get('area');
    if (area) root.querySelector<HTMLButtonElement>(`[data-filter="${CSS.escape(area)}"]`)?.click();
  });
</script>
