---
/**
 * Filtro de serviços (ilha mínima em JS puro): chips de categoria + busca por texto.
 * Sem JS, todos os cards continuam visíveis e navegáveis.
 */
import { Search } from '@lucide/astro';
import ServiceCard from './ServiceCard.astro';
import { categories } from '@/config/site';
import type { Service } from '@/lib/services';

interface Props {
  services: Service[];
  withSearch?: boolean;
}
const { services, withSearch = true } = Astro.props;
const chips = [{ key: 'all', label: 'Todos' }, ...Object.entries(categories).map(([key, c]) => ({ key, label: c.label }))];
---

<div data-service-filter>
  <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div
      class="-mx-4 flex snap-x gap-2 overflow-x-auto px-4 pb-1 [scrollbar-width:none] sm:mx-0 sm:flex-wrap sm:px-0"
      role="group"
      aria-label="Filtrar por área"
    >
      {
        chips.map((c, i) => (
          <button
            type="button"
            data-filter={c.key}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="shrink-0 snap-start rounded-full border border-brand-200 bg-white px-4 py-2 text-sm font-semibold whitespace-nowrap text-brand-700 transition hover:border-brand-400 aria-pressed:border-brand-700 aria-pressed:bg-brand-700 aria-pressed:text-white"
          >
            {c.label}
          </button>
        ))
      }
    </div>
    {
      withSearch && (
        <label class="relative block md:w-72">
          <span class="sr-only">Buscar serviço</span>
          <Search size={18} class="pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 text-brand-400" aria-hidden="true" />
          <input
            type="search"
            data-search-input
            placeholder="Buscar: PGR, LTCAT, licença…"
            class="h-12 w-full rounded-full border border-brand-200 bg-white pr-4 pl-11 text-base text-ink placeholder:text-muted/70 focus:border-brand-500 focus:outline-none"
          />
        </label>
      )
    }
  </div>

  <div class="mt-8 grid gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3" data-service-grid>
    {services.map((s, i) => <ServiceCard service={s} delay={(i % 3) * 80} />)}
  </div>
  <p data-empty class="mt-8 hidden rounded-2xl bg-mist p-6 text-center text-muted">
    Nenhum serviço encontrado. <a href="/contato/" class="font-semibold text-brand-600 underline">Fale com a gente</a> — provavelmente podemos ajudar.
  </p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-service-filter]').forEach((root) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const input = root.querySelector<HTMLInputElement>('[data-search-input]');
    const cards = root.querySelectorAll<HTMLElement>('[data-service]');
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    let cat = 'all';

    const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

    const apply = () => {
      const q = norm(input?.value.trim() ?? '');
      let visible = 0;
      cards.forEach((c) => {
        const show = (cat === 'all' || c.dataset.category === cat) && (!q || norm(c.dataset.search ?? '').includes(q));
        c.hidden = !show;
        if (show) {
          c.classList.add('is-visible');
          visible++;
        }
      });
      empty.classList.toggle('hidden', visible > 0);
    };

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        cat = b.dataset.filter!;
        buttons.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
        apply();
      }),
    );
    input?.addEventListener('input', apply);

    // Permite links como /servicos/?area=meio-ambiente
    const area = new URLSearchParams(location.search).get('area');
    if (area) root.querySelector<HTMLButtonElement>(`[data-filter="${CSS.escape(area)}"]`)?.click();
  });
</script>
