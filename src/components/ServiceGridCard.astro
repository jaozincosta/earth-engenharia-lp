---
/**
 * Card de serviço com foto de fundo (home). No hover/foco a imagem aproxima, a borda
 * acende em verde e a descrição + "Saiba mais" aparecem. Em telas de toque o texto
 * fica sempre visível.
 */
import { Picture } from 'astro:assets';
import { ArrowUpRight } from '@lucide/astro';
import Icon from './Icon.astro';
import { serviceImage } from '@/config/media';
import { serviceUrl, type Service } from '@/lib/services';

interface Props {
  service: Service;
  index: number;
}
const { service, index } = Astro.props;
const { data } = service;
const img = serviceImage(service.id);
---

<li data-reveal style={`--reveal-delay:${(index % 4) * 70}ms`}>
  <a
    href={serviceUrl(service)}
    class="group relative isolate flex aspect-[4/5] flex-col justify-end overflow-hidden rounded-2xl border border-line transition duration-300 hover:border-leaf-400/70 hover:shadow-[0_0_0_1px_rgb(122_201_67/0.35),0_24px_60px_-24px_rgb(122_201_67/0.45)] focus-visible:border-leaf-400 sm:aspect-[3/4]"
  >
    <div class="zoom-img absolute inset-0 -z-20">
      <Picture
        src={img.src}
        formats={['avif', 'webp']}
        widths={[360, 540, 720]}
        sizes="(min-width: 1024px) 24vw, (min-width: 640px) 46vw, 92vw"
        alt={img.alt}
        class="size-full object-cover"
        style={img.position ? `object-position:${img.position}` : undefined}
      />
    </div>
    <div class="overlay-bottom absolute inset-0 -z-10 transition-opacity duration-300" aria-hidden="true"></div>

    <span class="absolute top-4 left-4 grid size-11 place-items-center rounded-lg border border-line bg-surface/60 text-leaf-400 backdrop-blur-md">
      <Icon name={data.icon} size={22} />
    </span>
    <span class="tech absolute top-5 right-4 text-ink/70">{String(index + 1).padStart(2, '0')}</span>

    <div class="p-5">
      <h3 class="text-xl leading-snug">{data.title}</h3>
      <div class="grid transition-[grid-template-rows] duration-300 ease-out [@media(hover:hover)]:grid-rows-[0fr] [@media(hover:hover)]:group-hover:grid-rows-[1fr] [@media(hover:hover)]:group-focus-visible:grid-rows-[1fr]">
        <div class="overflow-hidden">
          <p class="pt-2 text-[15px] leading-relaxed text-ink/80">{data.summary}</p>
          <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-leaf-300">
            Saiba mais <span class="sr-only">sobre {data.title}</span>
            <ArrowUpRight size={16} aria-hidden="true" />
          </span>
        </div>
      </div>
    </div>
  </a>
</li>
