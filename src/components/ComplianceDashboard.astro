---
/**
 * Mockup de "painel de conformidade" (HTML/CSS puro) — ilustra como a EARTH controla
 * licenças, laudos e prazos do cliente. Dados de exemplo, marcados como ilustrativos.
 */
import { FileCheck, ShieldCheck, ClipboardCheck, Flame, GraduationCap } from '@lucide/astro';

const rows = [
  { icon: FileCheck, name: 'Licença de Operação', meta: 'CETESB', status: 'ok', label: 'Vigente', days: '214 dias' },
  { icon: ShieldCheck, name: 'PGR — Inventário de riscos', meta: 'NR-01', status: 'warn', label: 'Revisar', days: '28 dias' },
  { icon: ClipboardCheck, name: 'LTCAT', meta: 'S-2240', status: 'ok', label: 'Vigente', days: '301 dias' },
  { icon: Flame, name: 'AVCB', meta: 'Bombeiros SP', status: 'ok', label: 'Vigente', days: '1 ano' },
  { icon: GraduationCap, name: 'Reciclagem NR-35', meta: '12 colaboradores', status: 'warn', label: 'Agendar', days: '45 dias' },
] as const;

const bars = [62, 70, 68, 78, 84, 81, 90, 94];
---

<div class="relative">
  <div class="panel overflow-hidden shadow-[0_32px_64px_-32px_rgb(10_26_18/0.35)]">
    <!-- barra da janela -->
    <div class="flex items-center justify-between border-b border-line bg-mist px-4 py-2.5">
      <div class="flex gap-1.5" aria-hidden="true">
        <span class="size-2.5 rounded-full bg-line"></span><span class="size-2.5 rounded-full bg-line"></span><span class="size-2.5 rounded-full bg-line"></span>
      </div>
      <span class="font-mono text-[10px] tracking-[0.14em] text-muted uppercase">Painel de conformidade</span>
      <span class="flex items-center gap-1.5 font-mono text-[10px] text-brand-600"><span class="pulse-dot size-1.5 rounded-full bg-leaf-400"></span>ao vivo</span>
    </div>

    <div class="grid gap-px bg-line sm:grid-cols-3">
      <div class="bg-white p-4 sm:col-span-2">
        <p class="font-mono text-[10px] tracking-[0.14em] text-muted uppercase">Índice de conformidade</p>
        <div class="mt-1 flex items-end gap-2">
          <span class="text-4xl font-semibold tracking-tight">94<span class="text-xl text-muted">%</span></span>
          <span class="mb-1.5 font-mono text-xs text-brand-600">▲ 12 pts</span>
        </div>
        <div class="mt-3 flex h-16 items-end gap-1.5" aria-hidden="true">
          {bars.map((b, i) => <span class="bar-grow flex-1 rounded-sm bg-brand-100 last:bg-leaf-400" style={`height:${b}%;animation-delay:${i * 60}ms`} />)}
        </div>
      </div>
      <div class="grid grid-cols-2 gap-px bg-line sm:grid-cols-1">
        <div class="bg-white p-4">
          <p class="font-mono text-[10px] tracking-[0.14em] text-muted uppercase">Documentos</p>
          <p class="mt-1 text-2xl font-semibold tracking-tight">18</p>
        </div>
        <div class="bg-white p-4">
          <p class="font-mono text-[10px] tracking-[0.14em] text-muted uppercase">Vencendo</p>
          <p class="mt-1 text-2xl font-semibold tracking-tight text-warn">2</p>
        </div>
      </div>
    </div>

    <ul class="divide-y divide-line border-t border-line">
      {
        rows.map((r) => (
          <li class="flex items-center gap-3 px-4 py-3">
            <r.icon size={17} class="shrink-0 text-brand-500" aria-hidden="true" />
            <span class="min-w-0 flex-1">
              <span class="block truncate text-sm font-medium">{r.name}</span>
              <span class="block font-mono text-[10px] text-muted uppercase">{r.meta}</span>
            </span>
            <span class:list={['status', r.status === 'ok' ? 'status-ok' : 'status-warn']}>{r.label}</span>
            <span class="hidden w-16 text-right font-mono text-[11px] text-muted sm:block">{r.days}</span>
          </li>
        ))
      }
    </ul>
  </div>
  <p class="mt-3 text-right font-mono text-[10px] tracking-wide text-muted">* Ilustração com dados de exemplo</p>
</div>
