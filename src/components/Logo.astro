---
/**
 * Logo vetorial da EARTH Engenharia (gerado por scripts/build-logo.mjs, texto em curvas).
 * variant="light" para fundos claros, "dark" para fundos escuros.
 */
import LogoLight from '@/assets/logo.svg';
import LogoDark from '@/assets/logo-white.svg';

interface Props {
  variant?: 'light' | 'dark';
  class?: string;
}
const { variant = 'light', class: className = 'h-10 w-auto' } = Astro.props;
const Cmp = variant === 'dark' ? LogoDark : LogoLight;
---

<Cmp class={className} aria-label="EARTH Engenharia" role="img" />
