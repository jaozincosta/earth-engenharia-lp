---
import { ChevronDown, Menu, X, ArrowRight } from '@lucide/astro';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import BrandIcon from './BrandIcon.astro';
import { nav, site, whatsappUrl } from '@/config/site';
import { getServicesByCategory, serviceUrl } from '@/lib/services';

const groups = await getServicesByCategory();
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-transparent transition-[border-color,box-shadow] duration-300 data-[scrolled=true]:border-brand-100 data-[scrolled=true]:shadow-[0_8px_30px_-20px_rgb(15_77_46/0.35)]"
>
  <!-- O blur fica numa camada própria: backdrop-filter no <header> prenderia o menu mobile (position: fixed) dentro dele. -->
  <div class="absolute inset-0 -z-10 bg-white/80 backdrop-blur-xl" aria-hidden="true"></div>
  <a
    href="#conteudo"
    class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[60] focus:rounded-full focus:bg-brand-700 focus:px-4 focus:py-2 focus:text-white"
    >Pular para o conteúdo</a
  >
  <div class="container-x flex h-16 items-center justify-between gap-4 lg:h-20">
    <a href="/" class="shrink-0 text-brand-800" aria-label={`${site.name} — página inicial`}>
      <Logo class="h-9 w-auto lg:h-10" />
    </a>

    <!-- Navegação desktop -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Principal">
      {
        nav.map((item) =>
          item.href === '/servicos/' ? (
            <div class="group relative">
              <a
                href={item.href}
                class:list={[
                  'inline-flex items-center gap-1 rounded-full px-4 py-2 text-[15px] font-medium transition hover:bg-brand-50 hover:text-brand-700',
                  isActive(item.href) ? 'text-brand-700' : 'text-ink/80',
                ]}
                aria-haspopup="true"
              >
                {item.label}
                <ChevronDown size={16} class="transition group-hover:rotate-180 group-focus-within:rotate-180" aria-hidden="true" />
              </a>
              <div class="invisible absolute top-full left-1/2 w-[min(56rem,90vw)] -translate-x-1/2 translate-y-2 pt-3 opacity-0 transition duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
                <div class="glass grid grid-cols-3 gap-6 rounded-3xl p-6">
                  {groups.map((g) => (
                    <div>
                      <p class="mb-3 text-xs font-bold tracking-wider text-leaf-600 uppercase">{g.label}</p>
                      <ul class="space-y-1">
                        {g.services.map((s) => (
                          <li>
                            <a
                              href={serviceUrl(s)}
                              class="flex items-start gap-3 rounded-xl p-2 text-sm font-medium text-ink/85 transition hover:bg-brand-50 hover:text-brand-700"
                            >
                              <Icon name={s.data.icon} size={18} class="mt-0.5 shrink-0 text-brand-500" />
                              <span>{s.data.title}</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class:list={[
                'rounded-full px-4 py-2 text-[15px] font-medium transition hover:bg-brand-50 hover:text-brand-700',
                isActive(item.href) ? 'text-brand-700' : 'text-ink/80',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ),
        )
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={whatsappUrl()}
        target="_blank"
        rel="noopener"
        class="btn btn-primary hidden min-h-11 px-5 text-sm sm:inline-flex"
        data-track="whatsapp-header"
      >
        <BrandIcon name="whatsapp" class="size-4" /> Fale no WhatsApp
      </a>
      <button
        type="button"
        id="menu-toggle"
        class="grid size-11 place-items-center rounded-full border border-brand-100 bg-white text-brand-800 lg:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Abrir menu"
      >
        <Menu size={22} class="menu-open" aria-hidden="true" />
        <X size={22} class="menu-close hidden" aria-hidden="true" />
      </button>
    </div>
  </div>

  <!-- Menu mobile -->
  <div
    id="mobile-menu"
    class="fixed inset-x-0 top-16 bottom-0 hidden overflow-y-auto overscroll-contain bg-white lg:hidden"
  >
    <nav class="container-x flex flex-col gap-1 py-6" aria-label="Menu mobile">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="flex items-center justify-between rounded-2xl px-4 py-3.5 text-lg font-semibold text-brand-900 active:bg-brand-50"
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
            <ArrowRight size={18} class="text-brand-400" aria-hidden="true" />
          </a>
        ))
      }

      <div class="mt-4 space-y-5 rounded-3xl bg-mist p-4">
        {
          groups.map((g) => (
            <div>
              <p class="mb-1 px-2 text-xs font-bold tracking-wider text-leaf-600 uppercase">{g.label}</p>
              <ul>
                {g.services.map((s) => (
                  <li>
                    <a
                      href={serviceUrl(s)}
                      class="flex items-center gap-3 rounded-xl px-2 py-2.5 text-[15px] font-medium text-ink/85 active:bg-white"
                    >
                      <Icon name={s.data.icon} size={18} class="shrink-0 text-brand-500" />
                      {s.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <a href={whatsappUrl()} target="_blank" rel="noopener" class="btn btn-primary mt-6 w-full" data-track="whatsapp-menu">
        <BrandIcon name="whatsapp" class="size-5" /> Falar no WhatsApp
      </a>
      <a href={`tel:${site.contact.phoneHref}`} class="btn btn-outline mt-2 w-full">Ligar: {site.contact.phoneDisplay}</a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;

  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
    menu.classList.toggle('hidden', !open);
    toggle.querySelector('.menu-open')?.classList.toggle('hidden', open);
    toggle.querySelector('.menu-close')?.classList.toggle('hidden', !open);
    document.documentElement.classList.toggle('overflow-hidden', open);
  };

  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
  matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && setOpen(false));

  const onScroll = () => (header.dataset.scrolled = String(window.scrollY > 8));
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });
</script>
