---
import { Phone } from '@lucide/astro';
import BrandIcon from './BrandIcon.astro';
import { site, whatsappUrl } from '@/config/site';

interface Props {
  title?: string;
  text?: string;
  message?: string;
}
const {
  title = 'Vamos regularizar sua empresa?',
  text = 'Fale com um especialista e receba uma orientação inicial sem compromisso. Respondemos rápido pelo WhatsApp.',
  message,
} = Astro.props;
---

<section class="container-x py-16 sm:py-20">
  <div class="bg-hero relative overflow-hidden rounded-[2rem] px-6 py-12 text-center text-white sm:px-12 sm:py-16" data-reveal>
    <div class="bg-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-2xl">
      <p class="text-sm font-semibold tracking-wider text-leaf-300 uppercase">{site.slogans.future}</p>
      <h2 class="mt-3 text-3xl text-white sm:text-4xl">{title}</h2>
      <p class="mt-4 text-lg text-white/80">{text}</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={whatsappUrl(message)} target="_blank" rel="noopener" class="btn btn-primary" data-track="whatsapp-cta">
          <BrandIcon name="whatsapp" /> Chamar no WhatsApp
        </a>
        <a href={`tel:${site.contact.phoneHref}`} class="btn btn-ghost">
          <Phone size={18} aria-hidden="true" /> {site.contact.phoneDisplay}
        </a>
      </div>
    </div>
  </div>
</section>
