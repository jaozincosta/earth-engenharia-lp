---
import { Picture } from 'astro:assets';
import { Phone, ArrowRight } from '@lucide/astro';
import BrandIcon from './BrandIcon.astro';
import { site, whatsappUrl } from '@/config/site';
import { sectionImages } from '@/config/media';

interface Props {
  title?: string;
  text?: string;
  message?: string;
}
const {
  title = 'Coloque sua empresa em conformidade.',
  text = 'Fale com um especialista e receba uma orientação inicial sem compromisso. Respondemos rápido pelo WhatsApp.',
  message,
} = Astro.props;
const img = sectionImages.cta;
---

<section class="relative isolate overflow-hidden border-y border-line" aria-label="Solicitar orçamento">
  <Picture src={img.src} formats={['avif', 'webp']} widths={[640, 1280, 1920]} sizes="100vw" alt="" class="absolute inset-0 -z-20 size-full object-cover" />
  <div class="overlay-full absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="bg-grid pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="container-x grid gap-10 py-20 sm:py-24 lg:grid-cols-12 lg:items-end lg:py-32">
    <div class="lg:col-span-7" data-reveal>
      <p class="label">{site.slogans.future}</p>
      <h2 class="h-section mt-4">{title}</h2>
      <p class="mt-4 max-w-xl text-lg text-ink/80">{text}</p>
    </div>
    <div class="glow flex flex-col gap-3 lg:col-span-5 lg:pl-10" data-reveal>
      <a href={whatsappUrl(message)} target="_blank" rel="noopener" class="btn btn-whatsapp min-h-14 justify-between px-6 text-base" data-track="whatsapp-cta">
        <span class="inline-flex items-center gap-2"><BrandIcon name="whatsapp" class="size-6" /> Chamar no WhatsApp</span>
        <ArrowRight size={18} aria-hidden="true" />
      </a>
      <a href={`tel:${site.contact.phoneHref}`} class="btn btn-secondary min-h-14 justify-between px-6">
        <span class="inline-flex items-center gap-2"><Phone size={18} aria-hidden="true" /> {site.contact.phoneDisplay}</span>
        <ArrowRight size={18} aria-hidden="true" />
      </a>
    </div>
  </div>
</section>
