---
import BrandIcon from './BrandIcon.astro';
import { whatsappUrl } from '@/config/site';
---

<a
  href={whatsappUrl()}
  target="_blank"
  rel="noopener"
  aria-label="Conversar no WhatsApp"
  data-track="whatsapp-float"
  class="fixed right-4 bottom-[max(1rem,env(safe-area-inset-bottom))] z-40 grid size-14 place-items-center rounded-full bg-[#25D366] text-white shadow-[0_8px_24px_-6px_rgb(10_26_18/0.45)] transition-transform hover:scale-105 motion-reduce:hover:scale-100 sm:right-6 sm:bottom-6"
>
  <BrandIcon name="whatsapp" class="size-7" />
</a>
