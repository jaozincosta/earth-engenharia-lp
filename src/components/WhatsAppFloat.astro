---
import BrandIcon from './BrandIcon.astro';
import { whatsappUrl } from '@/config/site';
---

<a
  href={whatsappUrl()}
  target="_blank"
  rel="noopener"
  aria-label="Conversar no WhatsApp"
  data-track="whatsapp-float"
  class="group fixed right-4 bottom-[max(1rem,env(safe-area-inset-bottom))] z-40 inline-flex items-center gap-2 rounded-full bg-[#25D366] p-3.5 text-white shadow-[0_12px_30px_-8px_rgb(37_211_102/0.7)] transition hover:scale-105 hover:bg-[#1ebe5b] motion-reduce:transition-none motion-reduce:hover:scale-100 sm:right-6 sm:bottom-6"
>
  <span class="absolute inset-0 -z-10 animate-ping rounded-full bg-[#25D366]/40 motion-reduce:hidden" aria-hidden="true"></span>
  <BrandIcon name="whatsapp" class="size-7" />
  <span class="hidden pr-1 text-sm font-semibold sm:inline">Orçamento rápido</span>
</a>
