---
import '@/styles/global.css';
import SEO, { type PreloadImage } from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppFloat from '@/components/WhatsAppFloat.astro';
import BackToTop from '@/components/BackToTop.astro';
import { site } from '@/config/site';
import { breadcrumbs as breadcrumbSchema, localBusiness, website } from '@/lib/schema';

interface Props {
  /** <title> completo (50–60 caracteres). */
  title: string;
  /** Meta description (140–160 caracteres). */
  description: string;
  image?: string;
  noindex?: boolean;
  /** JSON-LD adicional da página. */
  schema?: Record<string, unknown>[];
  /** Breadcrumb (sem "Início") — gera o schema BreadcrumbList. */
  breadcrumbs?: { label: string; href: string }[];
  preloadImage?: PreloadImage;
  /** Mensagem pré-preenchida do botão flutuante de WhatsApp. */
  whatsappMessage?: string;
}

const { title, description, image, noindex, schema = [], breadcrumbs, preloadImage, whatsappMessage } = Astro.props;
const base = Astro.site!;
const jsonLd = [localBusiness(base), website(base), ...(breadcrumbs ? [breadcrumbSchema(breadcrumbs, base)] : []), ...schema];
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <SEO title={title} description={description} image={image} noindex={noindex} jsonLd={jsonLd} preloadImage={preloadImage} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <Header />
    <main id="conteudo" class="flex-1">
      <slot />
    </main>
    <Footer />
    <BackToTop />
    <WhatsAppFloat message={whatsappMessage} />

    <script>
      // Revela elementos [data-reveal] ao entrar na viewport (o CSS respeita prefers-reduced-motion).
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
